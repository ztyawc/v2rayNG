+// This decoder is independent of Xray's address parser: the mock node checks
+// the actual wire, including packet length, rather than calling the encoder
+// under test to construct its expected result.
+func cmccTestParseAddress(packet []byte, offset int) (string, int, int, error) {
+	if len(packet) <= offset {
+		return "", 0, 0, io.ErrUnexpectedEOF
+	}
+	family := packet[offset]
+	offset++
+	length := 0
+	switch family {
+	case 1:
+		length = 4
+	case 4:
+		length = 16
+	case 3:
+		if len(packet) <= offset {
+			return "", 0, 0, io.ErrUnexpectedEOF
+		}
+		length = int(packet[offset])
+		offset++
+	default:
+		return "", 0, 0, fmt.Errorf("unknown address type")
+	}
+	if len(packet) < offset+length+2 {
+		return "", 0, 0, io.ErrUnexpectedEOF
+	}
+	host := string(packet[offset : offset+length])
+	if family != 3 {
+		host = gonet.IP(packet[offset : offset+length]).String()
+	}
+	offset += length
+	port := int(binary.BigEndian.Uint16(packet[offset : offset+2]))
+	return host, port, offset + 2, nil
+}
