+type cmccTestPolicy struct{}
+
+func (cmccTestPolicy) Type() interface{}              { return policy.ManagerType() }
+func (cmccTestPolicy) Start() error                   { return nil }
+func (cmccTestPolicy) Close() error                   { return nil }
+func (cmccTestPolicy) ForLevel(uint32) policy.Session { return policy.SessionDefault() }
+func (cmccTestPolicy) ForSystem() policy.System       { return policy.System{} }
+
+type cmccTestConnection struct {
+	gonet.Conn
+	closed atomic.Bool
+}
+
+func (c *cmccTestConnection) Close() error {
+	c.closed.Store(true)
+	return c.Conn.Close()
+}
+
+type cmccTestDialer struct {
+	tcpAddress  string
+	mu          sync.Mutex
+	connections []*cmccTestConnection
+}
+
+func (d *cmccTestDialer) Dial(ctx context.Context, destination net.Destination) (stat.Connection, error) {
+	address := gonet.JoinHostPort(strings.Trim(destination.Address.String(), "[]"), fmt.Sprint(destination.Port))
+	if destination.Network == net.Network_TCP {
+		address = d.tcpAddress
+	} else if destination.Address.String() != "127.0.0.1" {
+		return nil, fmt.Errorf("UDP fallback did not use the accepted TCP peer")
+	}
+	conn, err := (&gonet.Dialer{}).DialContext(ctx, destination.Network.SystemString(), address)
+	if err != nil {
+		return nil, err
+	}
+	tracked := &cmccTestConnection{Conn: conn}
+	d.mu.Lock()
+	d.connections = append(d.connections, tracked)
+	d.mu.Unlock()
+	return tracked, nil
+}
+
+func (*cmccTestDialer) DestIpAddress() net.IP                                 { return nil }
+func (*cmccTestDialer) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+func (d *cmccTestDialer) allClosed(expected int) bool {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if len(d.connections) != expected {
+		return false
+	}
+	for _, c := range d.connections {
+		if !c.closed.Load() {
+			return false
+		}
+	}
+	return true
+}
