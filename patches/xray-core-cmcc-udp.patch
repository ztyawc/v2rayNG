+func TestCMCCUDPClientCancellationClosesBlockedHandshake(t *testing.T) {
+	listener, err := gonet.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ready := make(chan struct{})
+	serverDone := make(chan struct{})
+	go func() {
+		defer close(serverDone)
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		_, _ = readCMCCBytes(conn, 3)
+		_, _ = conn.Write([]byte{5, 0x82})
+		close(ready)
+		_, _ = io.Copy(io.Discard, conn)
+	}()
+	client, dialer, ctx, cancel := cmccTestStartClient(t, cmccProtocol82, listener.Addr().String())
+	defer cancel()
+	up, _ := pipe.New()
+	_, down := pipe.New()
+	defer up.Interrupt()
+	defer down.Interrupt()
+	done := make(chan error, 1)
+	go func() { done <- client.Process(ctx, &transport.Link{Reader: up, Writer: down}, dialer) }()
+	select {
+	case <-ready:
+	case <-time.After(2 * time.Second):
+		t.Fatal("handshake did not begin")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("owner cancellation left handshake blocked")
+	}
+	if !dialer.allClosed(1) {
+		t.Fatal("cancelled handshake leaked its control socket")
+	}
+	<-serverDone
+}
