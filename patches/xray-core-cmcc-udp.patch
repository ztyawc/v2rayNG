+func TestCMCCUDPClientCloseJoinsActiveAndPendingRequests(t *testing.T) {
+	for _, mode := range []cmccProtocol{cmccProtocol80, cmccProtocol82} {
+		t.Run(fmt.Sprintf("%x", mode), func(t *testing.T) {
+			listener, _, _, serverDone := cmccTestStartUDPNode(t, mode, 1)
+			client, dialer, ctx, cancel := cmccTestStartClient(t, mode, listener.Addr().String())
+			defer cancel()
+			up, input := pipe.New()
+			output, down := pipe.New()
+			defer up.Interrupt()
+			defer down.Interrupt()
+			active := make(chan error, 1)
+			go func() { active <- client.Process(ctx, &transport.Link{Reader: up, Writer: down}, dialer) }()
+			if err := input.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("active"))}); err != nil {
+				t.Fatal(err)
+			}
+			mb, err := output.ReadMultiBufferTimeout(2 * time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			buf.ReleaseMulti(mb)
+			pendingUp, _ := pipe.New()
+			_, pendingDown := pipe.New()
+			defer pendingUp.Interrupt()
+			defer pendingDown.Interrupt()
+			pending := make(chan error, 1)
+			// The mock accepts one TCP connection. This second request connects
+			// into its backlog and waits for a challenge with no caller cancel.
+			go func() {
+				pending <- client.Process(ctx, &transport.Link{Reader: pendingUp, Writer: pendingDown}, dialer)
+			}()
+			deadline := time.Now().Add(2 * time.Second)
+			for {
+				dialer.mu.Lock()
+				count := len(dialer.connections)
+				dialer.mu.Unlock()
+				if count == 3 {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatal("pending handshake did not connect")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			closed := make(chan error, 1)
+			go func() { closed <- client.Close() }()
+			select {
+			case err := <-closed:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("native outbound Close did not join its requests")
+			}
+			if !dialer.allClosed(3) {
+				t.Fatal("native Close returned with sockets still open")
+			}
+			for _, done := range []chan error{active, pending} {
+				select {
+				case <-done:
+				case <-time.After(time.Second):
+					t.Fatal("native Close left a request running")
+				}
+			}
+			if err := client.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if err := client.Process(ctx, &transport.Link{Reader: up, Writer: down}, dialer); err == nil || !strings.Contains(err.Error(), "closed") {
+				t.Fatalf("closed outbound accepted new request: %v", err)
+			}
+			if err := <-serverDone; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
