+func TestCMCCUDPReaderDropsInvalidPacketsAndPreservesLargeReply(t *testing.T) {
+	payload := bytes.Repeat([]byte{0x00, 0x80, 0xff, 'u'}, 5000)
+	header := []byte{0, 0, 0, 1, 192, 0, 2, 1, 0, 53}
+	input := &cmccTestDatagrams{packets: [][]byte{
+		{0, 0, 0, 1}, // actual received length, not unused buffer bytes
+		{0, 0, 1, 1, 192, 0, 2, 1, 0, 53},
+		{1, 0, 0, 1, 192, 0, 2, 1, 0, 53},
+		{0, 0, 0, 4, 0, 0},
+		{0, 0, 0, 3, 11, 'x'},
+		append(header, payload...),
+	}}
+	r := &cmccUDPReader{ctx: context.Background(), reader: input}
+	mb, err := r.ReadMultiBuffer()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer buf.ReleaseMulti(mb)
+	if len(mb) != 1 || !bytes.Equal(mb[0].Bytes(), payload) || mb[0].UDP.Address.String() != "192.0.2.1" || mb[0].UDP.Port != 53 {
+		t.Fatal("large unmodified downlink payload or source address was lost")
+	}
+	if _, err := r.ReadMultiBuffer(); err != io.EOF {
+		t.Fatalf("EOF = %v", err)
+	}
+}
