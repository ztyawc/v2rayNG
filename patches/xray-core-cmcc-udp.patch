--- /dev/null
+++ b/proxy/socks/cmcc_udp.go
@@ -0,0 +1,146 @@
+package socks
+
+import (
+	"context"
+	"io"
+	"sync"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+)
+
+// Private UDP belongs to the CMCC association, including its control socket.
+// Keep its datagram buffers and lifetime separate from ordinary SOCKS: the
+// manual's complete-datagram XOR must never enter the ordinary transport.
+const cmccMaxUDPPacketSize = 65507
+
+type cmccUDPWriter struct {
+	writer  io.Writer
+	request *protocol.RequestHeader
+}
+
+func (w *cmccUDPWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		request := w.request
+		if b.UDP != nil {
+			request = &protocol.RequestHeader{Address: b.UDP.Address, Port: b.UDP.Port}
+		}
+		if request == nil || request.Address == nil {
+			return errors.New("missing CMCC SOCKS UDP target")
+		}
+		header := buf.New()
+		_, _ = header.Write([]byte{0, 0, 0})
+		err := addrParser.WriteAddressPort(header, request.Address, request.Port)
+		if err != nil {
+			header.Release()
+			return err
+		}
+		length := header.Len() + b.Len()
+		if length > cmccMaxUDPPacketSize {
+			header.Release()
+			return errors.New("CMCC SOCKS UDP datagram exceeds maximum size")
+		}
+		packet := buf.NewWithSize(length)
+		_, _ = packet.Write(header.Bytes())
+		header.Release()
+		_, _ = packet.Write(b.Bytes())
+		// One write is one datagram. A short datagram write is an error; a
+		// stream-style retry would create a second, invalid SOCKS packet.
+		n, err := (cmccXORWriter{Writer: w.writer}).Write(packet.Bytes())
+		packet.Release()
+		if err != nil {
+			return err
+		}
+		if int32(n) != length {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+type cmccUDPReader struct {
+	ctx    context.Context
+	reader io.Reader
+}
+
+func (r *cmccUDPReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	for {
+		// A regular Xray buffer can truncate large UDP replies. Preserve one
+		// entire datagram and decode only ReadFrom's actual received length.
+		packet := buf.NewWithSize(65536)
+		_, err := packet.ReadFrom(r.reader)
+		if err != nil {
+			packet.Release()
+			return nil, err
+		}
+		if packet.Len() < 4 || packet.Byte(0) != 0 || packet.Byte(1) != 0 || packet.Byte(2) != 0 {
+			packet.Release()
+			errors.LogDebug(r.ctx, "discarding malformed or fragmented CMCC SOCKS UDP datagram")
+			continue
+		}
+		request, err := DecodeUDPPacket(packet)
+		if err != nil {
+			packet.Release()
+			errors.LogDebug(r.ctx, "discarding truncated CMCC SOCKS UDP datagram")
+			continue
+		}
+		destination := request.Destination()
+		packet.UDP = &destination
+		return buf.MultiBuffer{packet}, nil
+	}
+}
+
+func cmccRelayUDP(ctx context.Context, control, udp net.Conn, link *transport.Link, request *protocol.RequestHeader, timer *signal.ActivityTimer, timeouts policy.Timeout) error {
+	var workers sync.WaitGroup
+	// RFC 1928 section 6 ties the association to its TCP control connection.
+	// Closing either socket also unblocks the workers during owner cancellation.
+	defer func() {
+		_ = control.Close()
+		_ = udp.Close()
+		_ = common.Interrupt(link.Reader)
+		_ = common.Interrupt(link.Writer)
+		workers.Wait()
+	}()
+	results := make(chan error, 3)
+	for _, work := range []func() error{
+		func() error {
+			defer timer.SetTimeout(timeouts.DownlinkOnly)
+			return buf.Copy(link.Reader, &cmccUDPWriter{writer: udp, request: request}, buf.UpdateActivity(timer))
+		},
+		func() error {
+			defer timer.SetTimeout(timeouts.UplinkOnly)
+			return buf.Copy(&cmccUDPReader{ctx: ctx, reader: udp}, link.Writer, buf.UpdateActivity(timer))
+		},
+		func() error {
+			_, err := io.Copy(io.Discard, control)
+			if err == nil {
+				err = io.EOF
+			}
+			return errors.New("CMCC SOCKS UDP control connection closed").Base(err)
+		},
+	} {
+		workers.Add(1)
+		go func(work func() error) {
+			defer workers.Done()
+			results <- work()
+		}(work)
+	}
+	for finished := 0; finished < 2; finished++ {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case err := <-results:
+			if err != nil {
+				return errors.New("CMCC SOCKS UDP association ends").Base(err)
+			}
+		}
+	}
+	return nil
+}
