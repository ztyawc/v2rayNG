+func TestCMCCUDPClientEndToEnd(t *testing.T) {
+	for _, mode := range []cmccProtocol{0, cmccProtocol80, cmccProtocol82} {
+		for _, relayType := range []byte{1, 0, 4} {
+			t.Run(fmt.Sprintf("%x/relay-%d", mode, relayType), func(t *testing.T) {
+				control, udp, accepted, serverDone := cmccTestStartUDPNode(t, mode, relayType)
+				client, dialer, ctx, cancel := cmccTestStartClient(t, mode, control.Addr().String())
+				defer cancel()
+				upReader, upWriter := pipe.New()
+				downReader, downWriter := pipe.New()
+				defer upReader.Interrupt()
+				defer downReader.Interrupt()
+				done := make(chan error, 1)
+				go func() { done <- client.Process(ctx, &transport.Link{Reader: upReader, Writer: downWriter}, dialer) }()
+				for i, target := range []net.Destination{
+					net.UDPDestination(net.ParseAddress("192.0.2.9"), 53),
+					net.UDPDestination(net.ParseAddress("2001:db8::9"), 5300),
+					net.UDPDestination(net.DomainAddress("dns.example"), 5353),
+				} {
+					payload := []byte{0x12, 0x34, 0, 1, 0x80, 0xff, byte(i)}
+					if i == 2 && mode != 0 {
+						payload = bytes.Repeat(payload, 3000)
+					}
+					b := buf.NewWithSize(int32(len(payload)))
+					_, _ = b.Write(payload)
+					if i != 0 {
+						b.UDP = &target
+					}
+					if err := upWriter.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+						t.Fatal(err)
+					}
+					mb, err := downReader.ReadMultiBufferTimeout(3 * time.Second)
+					if err != nil {
+						t.Fatal(err)
+					}
+					ok := len(mb) == 1 && bytes.Equal(mb[0].Bytes(), payload) && *mb[0].UDP == target
+					buf.ReleaseMulti(mb)
+					if !ok {
+						t.Fatal("UDP client lost payload, packet boundary, or per-packet destination")
+					}
+				}
+				if mode != 0 {
+					// Ending only TCP must terminate the still-open UDP socket and
+					// join both pipe workers, without waiting for the idle timeout.
+					select {
+					case c := <-accepted:
+						_ = c.Close()
+					case <-time.After(time.Second):
+						t.Fatal("node did not accept control socket")
+					}
+				} else {
+					cancel()
+				}
+				select {
+				case <-done:
+				case <-time.After(2 * time.Second):
+					t.Fatal("UDP association did not stop")
+				}
+				if !dialer.allClosed(2) {
+					t.Fatal("UDP/control sockets remained open")
+				}
+				_ = udp.Close()
+				if err := <-serverDone; err != nil {
+					t.Fatal(err)
+				}
+			})
+		}
+	}
+}
+
+func cmccTestStartClient(t *testing.T, mode cmccProtocol, address string) (*Client, *cmccTestDialer, context.Context, context.CancelFunc) {
+	t.Helper()
+	_, port, _ := gonet.SplitHostPort(address)
+	serverPort, _ := net.PortFromString(port)
+	var user *protocol.MemoryUser
+	if mode != 0 {
+		user = &protocol.MemoryUser{Email: fmt.Sprintf("%s0x%x", cmccProtocolEmailPrefix, mode), Account: &Account{Username: cmccTestUsername, Password: cmccTestPassword}}
+	}
+	serverAddress := net.DomainAddress("control.invalid")
+	if mode == 0 {
+		serverAddress = net.ParseAddress("127.0.0.1")
+	}
+	client := &Client{server: protocol.NewServerSpec(net.TCPDestination(serverAddress, serverPort), user), policyManager: cmccTestPolicy{}}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: net.UDPDestination(net.ParseAddress("192.0.2.9"), 53)}})
+	return client, &cmccTestDialer{tcpAddress: address}, ctx, cancel
+}
+
+func cmccTestStartUDPNode(t *testing.T, mode cmccProtocol, relayType byte) (gonet.Listener, *gonet.UDPConn, chan gonet.Conn, chan error) {
+	t.Helper()
+	listener, err := gonet.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	udp, err := gonet.ListenUDP("udp4", &gonet.UDPAddr{IP: gonet.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	accepted := make(chan gonet.Conn, 1)
+	done := make(chan error, 1)
+	var workers sync.WaitGroup
+	var control gonet.Conn
+	var mu sync.Mutex
+	t.Cleanup(func() {
+		_ = listener.Close()
+		_ = udp.Close()
+		mu.Lock()
+		if control != nil {
+			_ = control.Close()
+		}
+		mu.Unlock()
+		workers.Wait()
+	})
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		conn, err := listener.Accept()
+		if err != nil {
+			done <- err
+			return
+		}
+		mu.Lock()
+		control = conn
+		mu.Unlock()
+		accepted <- conn
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+		read := func(n int) ([]byte, error) {
+			if mode != 0 {
+				return readCMCCBytes(conn, n)
+			}
+			b := make([]byte, n)
+			_, err := io.ReadFull(conn, b)
+			return b, err
+		}
+		greeting, err := read(3)
+		if err != nil || !bytes.Equal(greeting, []byte{5, 1, byte(mode)}) {
+			done <- fmt.Errorf("invalid node greeting: %v", err)
+			return
+		}
+		if mode == 0 {
+			_, err = conn.Write([]byte{5, 0})
+		} else {
+			challenge := []byte{0x7a}
+			response := []byte{5, 0x7a}
+			if mode == cmccProtocol82 {
+				challenge = []byte{1, 2, 3, 4}
+				response = append([]byte{5, 0x82}, challenge...)
+			}
+			_, err = conn.Write(response)
+			length := 1 + 1 + len(cmccTestUsername) + 1 + 32
+			if mode == cmccProtocol82 {
+				length += 21
+			}
+			auth, readErr := read(length)
+			want, _ := cmccAuthenticationRequest(mode, cmccTestUsername, cmccTestPassword, challenge)
+			if err != nil || readErr != nil || !bytes.Equal(auth, want) {
+				done <- fmt.Errorf("invalid node authentication")
+				return
+			}
+			_, err = conn.Write([]byte{1, 0})
+		}
+		if err != nil {
+			done <- err
+			return
+		}
+		command, err := read(10)
+		if err != nil || !bytes.Equal(command, []byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0}) {
+			done <- fmt.Errorf("invalid UDP associate endpoint: %v", err)
+			return
+		}
+		relay := []byte{1, 127, 0, 0, 1}
+		if relayType == 0 {
+			relay = []byte{1, 0, 0, 0, 0}
+		}
+		if relayType == 4 {
+			relay = append([]byte{4}, make([]byte, 16)...)
+		}
+		port := udp.LocalAddr().(*gonet.UDPAddr).Port
+		relay = append(relay, byte(port>>8), byte(port))
+		_, err = conn.Write(append([]byte{5, 0, 0}, relay...))
+		if err != nil {
+			done <- err
+			return
+		}
+		_, _ = io.Copy(io.Discard, conn)
+		done <- nil
+	}()
+	go func() {
+		defer workers.Done()
+		packet := make([]byte, 65536)
+		for {
+			n, from, err := udp.ReadFromUDP(packet)
+			if err != nil {
+				return
+			}
+			wire := packet[:n]
+			if mode != 0 {
+				for i := range wire {
+					wire[i] ^= 0xff
+				}
+			}
+			if len(wire) < 4 || !bytes.Equal(wire[:3], []byte{0, 0, 0}) {
+				continue
+			}
+			if _, _, _, err := cmccTestParseAddress(wire, 3); err != nil {
+				continue
+			}
+			if mode != 0 {
+				_, _ = udp.WriteToUDP([]byte{0, 0, 0, 1}, from)
+			}
+			_, _ = udp.WriteToUDP(wire, from)
+		}
+	}()
+	return listener, udp, accepted, done
+}
