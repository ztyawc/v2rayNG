+
+func TestCMCCUDPHandshake(t *testing.T) {
+	for _, mode := range []cmccProtocol{cmccProtocol80, cmccProtocol82} {
+		for _, relay := range []struct {
+			name string
+			wire []byte
+			host string
+		}{
+			{"ipv4", []byte{1, 192, 0, 2, 8, 0x12, 0x34}, "192.0.2.8"},
+			{"ipv6", append(append([]byte{4}, gonet.ParseIP("2001:db8::8").To16()...), 0x12, 0x34), "2001:db8::8"},
+			{"domain", append(append([]byte{3, 11}, []byte("udp.example")...), 0x12, 0x34), "udp.example"},
+		} {
+			t.Run(fmt.Sprintf("%x/%s", mode, relay.name), func(t *testing.T) {
+				reply := cmccUDPHandshakeReply(mode, append([]byte{5, 0, 0}, relay.wire...))
+				request := cmccTestRequest()
+				request.Command = protocol.RequestCommandUDP
+				var written bytes.Buffer
+				got, err := cmccClientHandshake(request, bytes.NewReader(reply), cmccXORWriter{Writer: &written}, mode)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got.Command != protocol.RequestCommandUDP || got.Address != net.ParseAddress(relay.host) || got.Port != 0x1234 {
+					t.Fatalf("incorrect relay: %v", got.Destination())
+				}
+				wire := written.Bytes()
+				for i := range wire {
+					wire[i] ^= 0xff
+				}
+				if !bytes.HasSuffix(wire, []byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0}) {
+					t.Fatal("UDP ASSOCIATE must advertise the unspecified client endpoint, not the application target")
+				}
+			})
+		}
+	}
+}
+
+func cmccUDPHandshakeReply(mode cmccProtocol, reply []byte) []byte {
+	result := []byte{5, 0x7a}
+	if mode == cmccProtocol82 {
+		result = []byte{5, 0x82, 1, 2, 3, 4}
+	}
+	result = append(result, 1, 0)
+	return append(result, reply...)
+}
+
+func TestCMCCUDPHandshakeRejectsInvalidRelay(t *testing.T) {
+	for _, reply := range [][]byte{
+		{5, 0, 0, 1, 127, 0, 0, 1, 0, 0},  // zero relay port
+		{5, 0, 1, 1, 127, 0, 0, 1, 0, 53}, // reserved byte
+		{5, 7, 0, 1, 127, 0, 0, 1, 0, 53}, // unsupported command
+		{4, 0, 0, 1, 127, 0, 0, 1, 0, 53}, // version
+		{5, 0, 0, 4, 0, 0},                // truncated IPv6
+		{5, 0, 0, 3, 12, 'x'},             // truncated domain
+	} {
+		request := cmccTestRequest()
+		request.Command = protocol.RequestCommandUDP
+		if _, err := cmccClientHandshake(request, bytes.NewReader(cmccUDPHandshakeReply(cmccProtocol80, reply)), io.Discard, cmccProtocol80); err == nil {
+			t.Fatal("invalid UDP relay response was accepted")
+		}
+	}
+}
+
+func TestCMCC82RejectsMethodWithoutWaitingForChallenge(t *testing.T) {
+	client, server := gonet.Pipe()
+	defer client.Close()
+	defer server.Close()
+	_ = client.SetDeadline(time.Now().Add(time.Second))
+	done := make(chan error, 1)
+	go func() {
+		if _, err := readCMCCBytes(server, 3); err != nil {
+			done <- err
+			return
+		}
+		_, err := server.Write([]byte{5, 0xff})
+		done <- err
+	}()
+	_, err := cmccClientHandshake(cmccTestRequest(), client, cmccXORWriter{Writer: client}, cmccProtocol82)
+	if err == nil || !strings.Contains(err.Error(), "auth method") {
+		t.Fatalf("method rejection waited for missing challenge: %v", err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+type cmccTestDatagrams struct {
+	packets [][]byte
+	short   bool
+}
+
+func (d *cmccTestDatagrams) Write(p []byte) (int, error) {
+	d.packets = append(d.packets, bytes.Clone(p))
+	if d.short {
+		return len(p) - 1, nil
+	}
+	return len(p), nil
+}
+
+func (d *cmccTestDatagrams) Read(p []byte) (int, error) {
+	if len(d.packets) == 0 {
+		return 0, io.EOF
+	}
+	packet := d.packets[0]
+	d.packets = d.packets[1:]
+	if len(p) < len(packet) {
+		return 0, io.ErrShortBuffer
+	}
+	return copy(p, packet), nil
+}
+
+func TestCMCCUDPWriterXORsEntireDatagram(t *testing.T) {
+	targets := []net.Destination{
+		net.UDPDestination(net.ParseAddress("192.0.2.1"), 53),
+		net.UDPDestination(net.ParseAddress("2001:db8::1"), 5300),
+		net.UDPDestination(net.DomainAddress("dns.example"), 5353),
+	}
+	payload := []byte{0, 1, 0x7f, 0x80, 0xff}
+	var mb buf.MultiBuffer
+	for _, target := range targets {
+		packet := buf.New()
+		_, _ = packet.Write(payload)
+		packet.UDP = &target
+		mb = append(mb, packet)
+	}
+	output := &cmccTestDatagrams{}
+	if err := (&cmccUDPWriter{writer: output}).WriteMultiBuffer(mb); err != nil {
+		t.Fatal(err)
+	}
+	if len(output.packets) != len(targets) {
+		t.Fatal("packet boundaries were lost")
+	}
+	for i, wire := range output.packets {
+		if !bytes.Equal(wire[:3], []byte{0xff, 0xff, 0xff}) {
+			t.Fatal("SOCKS UDP header was not XORed")
+		}
+		for j := range wire {
+			wire[j] ^= 0xff
+		}
+		host, port, offset, err := cmccTestParseAddress(wire, 3)
+		if err != nil || net.ParseAddress(host) != targets[i].Address || port != int(targets[i].Port) || !bytes.Equal(wire[offset:], payload) {
+			t.Fatalf("incorrect UDP packet %d: %v", i, err)
+		}
+	}
+}
+
+func TestCMCCUDPWriterReportsShortAndOversizedDatagrams(t *testing.T) {
+	request := &protocol.RequestHeader{Address: net.ParseAddress("192.0.2.1"), Port: 53}
+	short := &cmccTestDatagrams{short: true}
+	if err := (&cmccUDPWriter{writer: short, request: request}).WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("payload"))}); err != io.ErrShortWrite {
+		t.Fatalf("short write error = %v", err)
+	}
+	if len(short.packets) != 1 {
+		t.Fatal("short UDP write retried as a second datagram")
+	}
+	output := &cmccTestDatagrams{}
+	if err := (&cmccUDPWriter{writer: output, request: request}).WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes(make([]byte, cmccMaxUDPPacketSize))}); err == nil || len(output.packets) != 0 {
+		t.Fatal("oversized UDP payload was silently sent or dropped")
+	}
+}
