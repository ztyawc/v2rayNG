+// ownCMCCRequest binds an association to this native outbound instance as well
+// as its caller. UDP dispatchers can detach caller cancellation, so the core's
+// outbound Close must cancel and join private requests before returning.
+func (c *Client) ownCMCCRequest(parent context.Context) (context.Context, func(), error) {
+	ctx, cancel := context.WithCancel(parent)
+	c.cmccMu.Lock()
+	if c.cmccClosed {
+		c.cmccMu.Unlock()
+		cancel()
+		return nil, nil, errors.New("CMCC SOCKS outbound is closed")
+	}
+	if c.cmccRequests == nil {
+		c.cmccRequests = make(map[context.Context]context.CancelFunc)
+	}
+	c.cmccRequests[ctx] = cancel
+	c.cmccWorkers.Add(1)
+	c.cmccMu.Unlock()
+	return ctx, func() {
+		cancel()
+		c.cmccMu.Lock()
+		delete(c.cmccRequests, ctx)
+		c.cmccMu.Unlock()
+		c.cmccWorkers.Done()
+	}, nil
+}
+
+// Close implements the optional native outbound lifecycle hook. Only CMCC
+// requests are registered here; ordinary SOCKS keeps its existing lifecycle.
+func (c *Client) Close() error {
+	c.cmccMu.Lock()
+	c.cmccClosed = true
+	for _, cancel := range c.cmccRequests {
+		cancel()
+	}
+	c.cmccMu.Unlock()
+	c.cmccWorkers.Wait()
+	return nil
+}
+
 func init() {
 	common.Must(common.RegisterConfig((*ClientConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
 		return NewClient(ctx, config.(*ClientConfig))
