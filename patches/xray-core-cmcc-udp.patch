+func TestCMCCUDPClientCancellationClosesActiveAssociation(t *testing.T) {
+	for _, mode := range []cmccProtocol{cmccProtocol80, cmccProtocol82} {
+		t.Run(fmt.Sprintf("%x", mode), func(t *testing.T) {
+			listener, _, _, serverDone := cmccTestStartUDPNode(t, mode, 1)
+			client, dialer, ctx, cancel := cmccTestStartClient(t, mode, listener.Addr().String())
+			defer cancel()
+			up, input := pipe.New()
+			output, down := pipe.New()
+			defer up.Interrupt()
+			defer down.Interrupt()
+			done := make(chan error, 1)
+			go func() { done <- client.Process(ctx, &transport.Link{Reader: up, Writer: down}, dialer) }()
+			if err := input.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("active"))}); err != nil {
+				t.Fatal(err)
+			}
+			mb, err := output.ReadMultiBufferTimeout(2 * time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			buf.ReleaseMulti(mb)
+			cancel()
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("active association ignored owner cancellation")
+			}
+			if !dialer.allClosed(2) {
+				t.Fatal("cancellation leaked TCP or UDP")
+			}
+			if err := input.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("late"))}); err == nil {
+				t.Fatal("cancelled association still accepted uplink work")
+			}
+			if err := <-serverDone; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
