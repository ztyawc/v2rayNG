+// SPDX-License-Identifier: MPL-2.0
+package conf
+
+import (
+	"errors"
+	"github.com/xtls/xray-core/proxy/uusni"
+	"google.golang.org/protobuf/proto"
+)
+
+type UuSniConfig struct {
+	Address  string  `json:"address"`
+	Port     uint32  `json:"port"`
+	ObfsKey  *uint32 `json:"obfsKey"`
+	SniCrypt *bool   `json:"sniCrypt"`
+	Level    uint32  `json:"level"`
+}
+
+func (c *UuSniConfig) Build() (proto.Message, error) {
+	if c.ObfsKey == nil || c.SniCrypt == nil {
+		return nil, errors.New("uusni: obfsKey and sniCrypt must be provided explicitly")
+	}
+	out := &uusni.Config{Address: c.Address, Port: c.Port, ObfsKey: *c.ObfsKey, SniCrypt: *c.SniCrypt, Level: c.Level}
+	return out, uusni.Validate(out)
+}
