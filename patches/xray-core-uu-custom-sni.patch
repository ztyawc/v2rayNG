+++ b/proxy/uusni/client_test.go
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: MPL-2.0
+package uusni
+
+import (
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+type testPolicy struct{}
+
+func (testPolicy) Type() interface{}              { return policy.ManagerType() }
+func (testPolicy) Start() error                   { return nil }
+func (testPolicy) Close() error                   { return nil }
+func (testPolicy) ForLevel(uint32) policy.Session { return policy.SessionDefault() }
+func (testPolicy) ForSystem() policy.System       { return policy.System{} }
+
+type testDialer struct {
+	calls atomic.Int32
+	work  func(context.Context, xnet.Destination) (stat.Connection, error)
+}
+
+func (d *testDialer) Dial(ctx context.Context, dest xnet.Destination) (stat.Connection, error) {
+	d.calls.Add(1)
+	return d.work(ctx, dest)
+}
+func (*testDialer) DestIpAddress() xnet.IP                                { return nil }
+func (*testDialer) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+func testContext(target xnet.Destination) context.Context {
+	return session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: target, Tag: "synthetic-test"}})
+}
+
+func testLink() (*transport.Link, *pipe.Writer, *pipe.Reader) {
+	ur, uw := pipe.New()
+	dr, dw := pipe.New()
+	return &transport.Link{Reader: ur, Writer: dw}, uw, dr
+}
+
+// Independent mock decoder: it never calls Header/addressKey/xor/xorConn.
+func readMockHeader(conn net.Conn, c *Config) (string, uint16, error) {
+	var prefix [7]byte
+	if _, err := io.ReadFull(conn, prefix[:]); err != nil {
+		return "", 0, err
+	}
+	for i := range prefix {
+		prefix[i] ^= byte(c.ObfsKey)
+	}
+	if string(prefix[:3]) != "UU\x01" || prefix[3] > 1 {
+		return "", 0, errors.New("wrong whole-header XOR or magic")
+	}
+	field := make([]byte, int(prefix[6]))
+	if _, err := io.ReadFull(conn, field); err != nil {
+		return "", 0, err
+	}
+	for i := range field {
+		field[i] ^= byte(c.ObfsKey)
+	}
+	if prefix[3] == 1 {
+		if len(field) < 33 || field[0] != 16 || !bytes.Equal(field[1:17], make([]byte, 16)) {
+			return "", 0, errors.New("wrong native IV")
+		}
+		seed := []byte(c.Address + ":" + strconv.Itoa(int(c.Port)))
+		for len(seed) < 16 {
+			seed = append(seed, 'U')
+		}
+		block, err := aes.NewCipher(seed[:16])
+		if err != nil {
+			return "", 0, err
+		}
+		aead, err := cipher.NewGCMWithNonceSize(block, 16)
+		if err != nil {
+			return "", 0, err
+		}
+		field, err = aead.Open(nil, field[1:17], field[17:], nil)
+		if err != nil {
+			return "", 0, err
+		}
+	}
+	return string(field), binary.BigEndian.Uint16(prefix[4:6]), nil
+}
+
+func TestProcessNoAckBidirectionalAndHalfClose(t *testing.T) {
+	for _, crypt := range []bool{false, true} {
+		t.Run(fmt.Sprint(crypt), func(t *testing.T) {
+			listener, err := net.Listen("tcp4", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			c := &Config{Address: "127.0.0.1", Port: uint32(listener.Addr().(*net.TCPAddr).Port), ObfsKey: 77, SniCrypt: crypt}
+			serverDone := make(chan error, 1)
+			payload := bytes.Repeat([]byte("client payload\x00\xff"), 3000)
+			go func() {
+				conn, err := listener.Accept()
+				if err != nil {
+					serverDone <- err
+					return
+				}
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+				host, port, err := readMockHeader(conn, c)
+				if err != nil {
+					serverDone <- err
+					return
+				}
+				if host != "example.com" || port != 80 {
+					serverDone <- errors.New("target changed")
+					return
+				}
+				// Banner is target data, not a handshake ACK. A client waiting for an
+				// invented ACK will lose this data or deadlock before upload starts.
+				banner := []byte("BANNER")
+				for i := range banner {
+					banner[i] ^= 77
+				}
+				if _, err = conn.Write(banner); err != nil {
+					serverDone <- err
+					return
+				}
+				body, err := io.ReadAll(conn)
+				if err != nil {
+					serverDone <- err
+					return
+				}
+				for i := range body {
+					body[i] ^= 77
+				}
+				if !bytes.Equal(body, payload) {
+					serverDone <- errors.New("upload corrupted")
+					return
+				}
+				reply := []byte("REPLY AFTER FIN")
+				for i := range reply {
+					reply[i] ^= 77
+				}
+				_, err = conn.Write(reply)
+				serverDone <- err
+			}()
+			dialer := &testDialer{work: func(ctx context.Context, dest xnet.Destination) (stat.Connection, error) {
+				if dest.Network != xnet.Network_TCP || dest.Address.String() != c.Address || uint32(dest.Port) != c.Port {
+					return nil, errors.New("wrong node")
+				}
+				return (&net.Dialer{}).DialContext(ctx, "tcp4", listener.Addr().String())
+			}}
+			client := &Client{config: c, policy: testPolicy{}}
+			defer client.Close()
+			link, upload, download := testLink()
+			defer upload.Close()
+			defer download.Interrupt()
+			done := make(chan error, 1)
+			go func() {
+				done <- client.Process(testContext(xnet.TCPDestination(xnet.DomainAddress("example.com"), 80)), link, dialer)
+			}()
+			reader := &buf.BufferedReader{Reader: download}
+			banner := make([]byte, 6)
+			if _, err = io.ReadFull(reader, banner); err != nil || string(banner) != "BANNER" {
+				t.Fatal("banner/ACK handling", err)
+			}
+			if err = upload.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes(payload)}); err != nil {
+				t.Fatal(err)
+			}
+			_ = upload.Close()
+			reply, err := io.ReadAll(reader)
+			if err != nil || string(reply) != "REPLY AFTER FIN" {
+				t.Fatal("half close lost response", string(reply), err)
+			}
+			select {
+			case err = <-done:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("Process did not join")
+			}
+			if err = <-serverDone; err != nil {
+				t.Fatal(err)
+			}
+			if dialer.calls.Load() != 1 {
+				t.Fatal("unexpected retry/fallback")
+			}
+		})
+	}
+}
+
+func TestRejectUnsupportedTargetsWithoutDial(t *testing.T) {
+	client := &Client{config: fixture(), policy: testPolicy{}}
+	defer client.Close()
+	dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) {
+		return nil, errors.New("unexpected dial")
+	}}
+	for _, target := range []xnet.Destination{xnet.UDPDestination(xnet.DomainAddress("example.com"), 53), xnet.TCPDestination(xnet.ParseAddress("::1"), 443), xnet.TCPDestination(xnet.DomainAddress("bad/host"), 443)} {
+		link, up, down := testLink()
+		if client.Process(testContext(target), link, dialer) == nil {
+			t.Fatal("unsupported target accepted")
+		}
+		up.Close()
+		down.Interrupt()
+	}
+	if dialer.calls.Load() != 0 {
+		t.Fatal("unsupported target caused network traffic")
+	}
+}
+
+func TestCloseCancelsBlockedHeaderAndRejectsNewFlows(t *testing.T) {
+	client := &Client{config: fixture(), policy: testPolicy{}}
+	peer, local := net.Pipe()
+	defer peer.Close()
+	entered := make(chan struct{})
+	dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) { close(entered); return local, nil }}
+	link, up, down := testLink()
+	defer up.Close()
+	defer down.Interrupt()
+	done := make(chan error, 1)
+	go func() {
+		done <- client.Process(testContext(xnet.TCPDestination(xnet.DomainAddress("example.com"), 443)), link, dialer)
+	}()
+	<-entered
+	closed := make(chan struct{})
+	go func() { client.Close(); client.Close(); close(closed) }()
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not cancel blocked handshake")
+	}
+	if err := <-done; err == nil {
+		t.Fatal("cancelled handshake reported success")
+	}
+	link2, up2, down2 := testLink()
+	defer up2.Close()
+	defer down2.Interrupt()
+	if err := client.Process(testContext(xnet.TCPDestination(xnet.DomainAddress("example.com"), 443)), link2, dialer); !errors.Is(err, net.ErrClosed) {
+		t.Fatal("closed outbound admitted flow", err)
+	}
+	if dialer.calls.Load() != 1 {
+		t.Fatal("cancel caused retry/fallback")
+	}
+}
+
+func TestDialFailureDoesNotFallback(t *testing.T) {
+	client := &Client{config: fixture(), policy: testPolicy{}}
+	defer client.Close()
+	rejected := errors.New("synthetic dial failure")
+	dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) { return nil, rejected }}
+	link, up, down := testLink()
+	defer up.Close()
+	defer down.Interrupt()
+	if err := client.Process(testContext(xnet.TCPDestination(xnet.DomainAddress("example.com"), 443)), link, dialer); !errors.Is(err, rejected) {
+		t.Fatal(err)
+	}
+	if dialer.calls.Load() != 1 {
+		t.Fatal("failed node used fallback")
+	}
+}
