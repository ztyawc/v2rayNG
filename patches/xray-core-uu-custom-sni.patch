index 0000000..5584ef6
--- /dev/null
+++ b/proxy/uusni/wire.go
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: MPL-2.0
+// UU 11.3.5 custom-SNI TCP, without outer TLS. See docs/uu-sni.md in the app.
+package uusni
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+)
+
+func Validate(c *Config) error {
+	if c == nil || c.Port == 0 || c.Port > 65535 || c.ObfsKey > 255 {
+		return errors.New("uusni: valid port and unsigned XOR byte required")
+	}
+	ip, err := netip.ParseAddr(c.Address)
+	if err != nil || !ip.Is4() || ip.IsUnspecified() || ip.As4()[0] >= 224 {
+		return errors.New("uusni: a numeric IPv4 node is required")
+	}
+	return nil
+}
+
+func addressKey(c *Config) [16]byte {
+	key := [16]byte{'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U', 'U'}
+	copy(key[:], c.Address+":"+strconv.FormatUint(uint64(c.Port), 10))
+	return key
+}
+
+func validHost(host string) bool {
+	if len(host) == 0 || len(host) > 253 {
+		return false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for i := range label {
+			b := label[i]
+			if !(b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z' || b >= '0' && b <= '9' || b == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Header already includes XOR over the ENTIRE header, not just the host blob.
+// The target port is preserved; this branch does not rewrite port 80 to 443.
+func Header(c *Config, host string, port uint16) ([]byte, error) {
+	if err := Validate(c); err != nil {
+		return nil, err
+	}
+	if port == 0 || !validHost(host) {
+		return nil, errors.New("uusni: invalid ASCII hostname/IPv4 target or port")
+	}
+	field := []byte(host)
+	flag := byte(0)
+	if c.SniCrypt {
+		// Native compatibility: AES-128-GCM, 16 ZERO IV bytes, empty AAD,
+		// and a 16-byte trailing tag. This fixed IV is not a safe new protocol design.
+		if len(field) > 222 {
+			return nil, errors.New("uusni: encrypted target exceeds one-byte field length")
+		}
+		key := addressKey(c)
+		block, err := aes.NewCipher(key[:])
+		if err != nil {
+			return nil, err
+		}
+		gcm, err := cipher.NewGCMWithNonceSize(block, 16)
+		if err != nil {
+			return nil, err
+		}
+		iv := make([]byte, 16)
+		blob := append([]byte{16}, iv...)
+		field = gcm.Seal(blob, iv, field, nil)
+		flag = 1
+	}
+	if len(field) > 255 {
+		return nil, errors.New("uusni: target field length overflow")
+	}
+	header := make([]byte, 7, 7+len(field))
+	copy(header, []byte{'U', 'U', 1, flag})
+	binary.BigEndian.PutUint16(header[4:6], port)
+	header[6] = byte(len(field))
+	header = append(header, field...)
+	xor(header, byte(c.ObfsKey))
+	return header, nil
+}
+
+func xor(data []byte, key byte) {
+	for i := range data {
+		data[i] ^= key
+	}
+}
+
+func writeFull(w io.Writer, data []byte) error {
+	for len(data) > 0 {
+		n, err := w.Write(data)
+		if n < 0 || n > len(data) {
+			return io.ErrShortWrite
+		}
+		data = data[n:]
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+// No ReaderFrom/WriterTo: kernel splice must never bypass the XOR operation.
+type xorConn struct {
+	net.Conn
+	key byte
+}
+
+func (c *xorConn) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	if n > 0 {
+		xor(p[:n], c.key)
+	}
+	return n, err
+}
+
+func (c *xorConn) Write(p []byte) (int, error) {
+	// Do not mutate caller buffers. Bound temporary storage for large writes.
+	total := 0
+	chunk := make([]byte, min(len(p), 32*1024))
+	for len(p) > 0 {
+		n := copy(chunk, p)
+		xor(chunk[:n], c.key)
+		written := 0
+		for written < n {
+			count, err := c.Conn.Write(chunk[written:n])
+			if count < 0 || count > n-written {
+				return total + written, io.ErrShortWrite
+			}
+			written += count
+			if err != nil {
+				return total + written, err
+			}
+			if count == 0 {
+				return total + written, io.ErrShortWrite
+			}
+		}
+		total += n
+		p = p[n:]
+	}
+	return total, nil
+}
diff --git a/proxy/uusni/wire_test.go b/proxy/uusni/wire_test.go
new file mode 100644
index 0000000..1e5e861
--- /dev/null
+++ b/proxy/uusni/wire_test.go
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: MPL-2.0
+package uusni
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"testing"
+)
+
+func fixture() *Config {
+	return &Config{Address: "203.0.113.10", Port: 5556, ObfsKey: 77, SniCrypt: true}
+}
+
+func TestHeaderIndependentVectors(t *testing.T) {
+	c := fixture()
+	got, err := Header(c, "example.com", 443)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Independently checked with Python/OpenSSL and C libmbedcrypto, not a
+	// round trip through a second copy of this Go encoder. All parameters synthetic.
+	clear, _ := hex.DecodeString("5555010101bb2c1000000000000000000000000000000000f174c41f691bd3bbcdacc5f0c241967be9b39b10be5f6f914f6d76")
+	if len(got) != len(clear) {
+		t.Fatalf("length %d != %d", len(got), len(clear))
+	}
+	for i := range got {
+		if got[i] != clear[i]^77 {
+			t.Fatalf("wire mismatch at %d", i)
+		}
+	}
+	c.SniCrypt, c.ObfsKey = false, 0
+	got, err = Header(c, "example.com", 80)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if hex.EncodeToString(got) != "5555010000500b6578616d706c652e636f6d" {
+		t.Fatal("target port 80 or clear header changed")
+	}
+}
+
+func TestKeyAndLengthBoundaries(t *testing.T) {
+	c := fixture()
+	key := addressKey(c)
+	if string(key[:]) != "203.0.113.10:555" {
+		t.Fatal("long endpoint not truncated")
+	}
+	c.Address, c.Port = "1.2.3.4", 8
+	key = addressKey(c)
+	if string(key[:]) != "1.2.3.4:8UUUUUUU" {
+		t.Fatal("short endpoint not U-padded")
+	}
+	host := strings.Repeat("a", 63) + "." + strings.Repeat("b", 63) + "." + strings.Repeat("c", 63) + "." + strings.Repeat("d", 30)
+	if _, err := Header(c, host, 443); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Header(c, host+"d", 443); err == nil {
+		t.Fatal("encrypted length wrapped")
+	}
+	for _, host := range []string{"", "bad\x00host", "a:b", "[::1]", "::1", "-bad.test", "bad..test", "a/host", "a@host", "域名.test", strings.Repeat("a", 64) + ".test"} {
+		if _, err := Header(c, host, 443); err == nil {
+			t.Fatalf("accepted invalid host %q", host)
+		}
+	}
+	for _, change := range []func(*Config){func(c *Config) { c.Port = 0 }, func(c *Config) { c.Port = 65536 }, func(c *Config) { c.ObfsKey = 256 }, func(c *Config) { c.Address = "node.test" }, func(c *Config) { c.Address = "::1" }, func(c *Config) { c.Address = "0.0.0.0" }, func(c *Config) { c.Address = "224.0.0.1" }} {
+		c := fixture()
+		change(c)
+		if Validate(c) == nil {
+			t.Fatal("accepted invalid node")
+		}
+	}
+}
+
+type shortConn struct {
+	net.Conn
+	bytes.Buffer
+	max  int
+	fail error
+	zero bool
+}
+
+func (c *shortConn) Write(p []byte) (int, error) {
+	if c.zero {
+		return 0, nil
+	}
+	n := min(len(p), c.max)
+	c.Buffer.Write(p[:n])
+	return n, c.fail
+}
+func (c *shortConn) Read(p []byte) (int, error) { return c.Buffer.Read(p) }
+
+func TestXorShortWritesKeepInputAndOffset(t *testing.T) {
+	plain := bytes.Repeat([]byte{0, 1, 2, 127, 128, 255}, 30000)
+	original := bytes.Clone(plain)
+	conn := &shortConn{max: 7}
+	x := &xorConn{Conn: conn, key: 77}
+	n, err := x.Write(plain)
+	if err != nil || n != len(plain) || !bytes.Equal(plain, original) {
+		t.Fatal("short write or caller-buffer mutation", n, err)
+	}
+	for i, b := range conn.Buffer.Bytes() {
+		if b != plain[i]^77 {
+			t.Fatal("XOR chunk offset changed")
+		}
+	}
+	got, err := io.ReadAll(x)
+	if err != nil || !bytes.Equal(got, plain) {
+		t.Fatal("read transform", err)
+	}
+	conn.zero = true
+	if _, err = x.Write([]byte("a")); !errors.Is(err, io.ErrShortWrite) {
+		t.Fatal("zero write was not rejected")
+	}
+	if err = writeFull(conn, []byte("a")); !errors.Is(err, io.ErrShortWrite) {
+		t.Fatal("header zero write was not rejected")
+	}
+	conn.zero = false
+	conn.fail = io.ErrClosedPipe
+	if n, err = x.Write([]byte("123456789")); n != 7 || !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatal("partial error count", n, err)
+	}
+}
