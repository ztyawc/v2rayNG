+// SPDX-License-Identifier: MPL-2.0
+package conf_test
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"github.com/xtls/xray-core/proxy/uusni"
+)
+
+func TestUuSniConfigRequiresExplicitParameters(t *testing.T) {
+	for _, body := range []string{
+		`{"address":"203.0.113.10","port":5556,"obfsKey":0,"sniCrypt":false}`,
+		`{"address":"203.0.113.10","port":5556,"obfsKey":255,"sniCrypt":true}`,
+	} {
+		var c conf.UuSniConfig
+		if err := json.Unmarshal([]byte(body), &c); err != nil {
+			t.Fatal(err)
+		}
+		out, err := c.Build()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if out.(*uusni.Config).Address != "203.0.113.10" {
+			t.Fatal("address lost")
+		}
+	}
+	for _, body := range []string{
+		`{}`, `{"address":"203.0.113.10","port":5556,"sniCrypt":true}`,
+		`{"address":"203.0.113.10","port":5556,"obfsKey":0}`,
+		`{"address":"203.0.113.10","port":65536,"obfsKey":77,"sniCrypt":true}`,
+		`{"address":"203.0.113.10","port":5556,"obfsKey":256,"sniCrypt":true}`,
+		`{"address":"203.0.113.10","port":5556,"obfsKey":-1,"sniCrypt":true}`,
+		`{"address":"node.test","port":5556,"obfsKey":77,"sniCrypt":true}`,
+	} {
+		var c conf.UuSniConfig
+		err := json.Unmarshal([]byte(body), &c)
+		if err == nil {
+			_, err = c.Build()
+		}
+		if err == nil {
+			t.Fatalf("invalid config accepted: %s", body)
+		}
+	}
+}
+
+type mockXor struct{ net.Conn }
+
+func (c mockXor) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	for i := 0; i < n; i++ {
+		p[i] ^= 77
+	}
+	return n, e
+}
+func (c mockXor) Write(p []byte) (int, error) {
+	b := bytes.Clone(p)
+	for i := range b {
+		b[i] ^= 77
+	}
+	return c.Conn.Write(b)
+}
+
+// Exercises JSON/protobuf registration, the native outbound factory, core
+// dispatch, independently decoded SNI framing, verified TLS and an HTTP body.
+// This uses a local mock node, not the user's real account/node parameters.
+func TestUuSniCoreVerifiedTLS(t *testing.T) {
+	website := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = io.WriteString(w, "native-uusni-body") }))
+	defer website.Close()
+	node, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer node.Close()
+	port := node.Addr().(*net.TCPAddr).Port
+	nodeDone := make(chan error, 1)
+	go func() {
+		conn, err := node.Accept()
+		if err != nil {
+			nodeDone <- err
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+		s := mockXor{conn}
+		var h [7]byte
+		if _, err = io.ReadFull(s, h[:]); err != nil {
+			nodeDone <- err
+			return
+		}
+		if !bytes.Equal(h[:4], []byte{'U', 'U', 1, 1}) || binary.BigEndian.Uint16(h[4:6]) != 443 {
+			nodeDone <- fmt.Errorf("wrong SNI prefix")
+			return
+		}
+		b := make([]byte, int(h[6]))
+		if _, err = io.ReadFull(s, b); err != nil {
+			nodeDone <- err
+			return
+		}
+		if len(b) < 33 || b[0] != 16 || !bytes.Equal(b[1:17], make([]byte, 16)) {
+			nodeDone <- fmt.Errorf("wrong GCM blob")
+			return
+		}
+		key := []byte(fmt.Sprintf("127.0.0.1:%dUUUUUUUUUUUUUUUU", port))[:16]
+		block, _ := aes.NewCipher(key)
+		aead, _ := cipher.NewGCMWithNonceSize(block, 16)
+		host, err := aead.Open(nil, b[1:17], b[17:], nil)
+		if err != nil || string(host) != "example.com" {
+			nodeDone <- fmt.Errorf("target host decrypt: %v", err)
+			return
+		}
+		up, err := net.Dial("tcp", website.Listener.Addr().String())
+		if err != nil {
+			nodeDone <- err
+			return
+		}
+		defer up.Close()
+		finished := make(chan struct{})
+		go func() { defer close(finished); _, _ = io.Copy(up, s); _ = up.Close() }()
+		_, err = io.Copy(s, up)
+		_ = conn.Close()
+		<-finished
+		nodeDone <- err
+	}()
+	body := fmt.Sprintf(`{"log":{"loglevel":"none"},"outbounds":[{"tag":"proxy","protocol":"uusni","settings":{"address":"127.0.0.1","port":%d,"obfsKey":77,"sniCrypt":true},"mux":{"enabled":false,"concurrency":-1}}]}`, port)
+	var config conf.Config
+	if err = json.Unmarshal([]byte(body), &config); err != nil {
+		t.Fatal(err)
+	}
+	compiled, err := config.Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance, err := core.New(compiled)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer instance.Close()
+	if err = instance.Start(); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	conn, err := core.Dial(ctx, instance, xnet.TCPDestination(xnet.DomainAddress("example.com"), 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+	roots := x509.NewCertPool()
+	roots.AddCert(website.Certificate())
+	tlsConn := tls.Client(conn, &tls.Config{RootCAs: roots, ServerName: "example.com", MinVersion: tls.VersionTLS12})
+	defer tlsConn.Close()
+	if err = tlsConn.HandshakeContext(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = io.WriteString(tlsConn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.ReadResponse(bufio.NewReader(tlsConn), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	got, err := io.ReadAll(response.Body)
+	if err != nil || response.StatusCode != 200 || string(got) != "native-uusni-body" {
+		t.Fatal(response.StatusCode, string(got), err)
+	}
+	_ = tlsConn.Close()
+	select {
+	case err = <-nodeDone:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("mock node did not terminate")
+	}
+	if err = instance.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
