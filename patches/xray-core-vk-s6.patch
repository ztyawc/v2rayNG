+// SPDX-License-Identifier: MPL-2.0
+package vks6
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+type testFakeDNS struct{}
+
+func (testFakeDNS) Type() interface{}                                     { return (*dns.FakeDNSEngine)(nil) }
+func (testFakeDNS) Start() error                                          { return nil }
+func (testFakeDNS) Close() error                                          { return nil }
+func (testFakeDNS) GetFakeIPForDomain(string) []xnet.Address              { return nil }
+func (testFakeDNS) GetDomainFromFakeDNS(xnet.Address) string              { return "original.example" }
+func (testFakeDNS) GetFakeIPForDomain3(string, bool, bool) []xnet.Address { return nil }
+func (testFakeDNS) IsIPInIPPool(ip xnet.Address) bool                     { return ip.String() == "203.0.113.77" }
+
+func TestConfiguredFakePoolIsRejectedBeforeDial(t *testing.T) {
+	client := &Client{config: fixture(), policy: testPolicy{}, fakeDNS: testFakeDNS{}}
+	defer client.Close()
+	dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) {
+		return nil, errors.New("unexpected dial")
+	}}
+	link, up, down := testLink()
+	defer up.Close()
+	defer down.Interrupt()
+	if client.Process(testContext(xnet.TCPDestination(xnet.ParseAddress("203.0.113.77"), 443)), link, dialer) == nil {
+		t.Fatal("custom fake pool accepted")
+	}
+	if dialer.calls.Load() != 0 {
+		t.Fatal("fake IP caused network traffic")
+	}
+}
diff --git a/proxy/vks6/wire.go b/proxy/vks6/wire.go
