index 00000000..365d6f5b
--- /dev/null
+++ b/infra/conf/vks6_core_test.go
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: MPL-2.0
+package conf_test
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+type mockVkS6Xor struct{ net.Conn }
+
+func (c mockVkS6Xor) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	for i := 0; i < n; i++ {
+		p[i] ^= 0x5a
+	}
+	return n, e
+}
+func (c mockVkS6Xor) Write(p []byte) (int, error) {
+	b := bytes.Clone(p)
+	for i := range b {
+		b[i] ^= 0x5a
+	}
+	return c.Conn.Write(b)
+}
+
+// Exercises JSON/protobuf registration, the native outbound factory, core
+// dispatch, independently decoded S6 framing, verified TLS and an HTTP body.
+// This uses a local mock node, not the user's real account/node parameters.
+func TestVkS6CoreDnsAndVerifiedTLS(t *testing.T) {
+	website := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = io.WriteString(w, "native-vks6-body") }))
+	defer website.Close()
+	node, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer node.Close()
+	port := node.Addr().(*net.TCPAddr).Port
+	nodeDone := make(chan error, 1)
+	go func() {
+		conn, err := node.Accept()
+		if err != nil {
+			nodeDone <- err
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+		request := make([]byte, 34)
+		if _, err = io.ReadFull(conn, request); err != nil {
+			nodeDone <- err
+			return
+		}
+		// Published independent vector, with target TCP port 443 instead of 80.
+		if hex.EncodeToString(request) != "06074a4d6917295837100c177650781e7577041f25012f4f262609012bae663601bb" {
+			nodeDone <- fmt.Errorf("wrong S6 request or IPv4 DNS resolution")
+			return
+		}
+		if _, err = conn.Write([]byte{6, 0}); err != nil {
+			nodeDone <- err
+			return
+		}
+		s := mockVkS6Xor{conn}
+		up, err := net.Dial("tcp", website.Listener.Addr().String())
+		if err != nil {
+			nodeDone <- err
+			return
+		}
+		defer up.Close()
+		finished := make(chan struct{})
+		go func() {
+			defer close(finished)
+			_, _ = io.Copy(up, s)
+			// Upload EOF must still allow the TLS server to finish its response.
+			if tcp, ok := up.(*net.TCPConn); ok {
+				_ = tcp.CloseWrite()
+			}
+		}()
+		// The HTTP body and TLS verification are asserted by the client below.
+		// A peer reset after that client closes is normal mock teardown, not
+		// a payload assertion; FIN behavior is tested separately in proxy/vks6.
+		_, _ = io.Copy(s, up)
+		_ = conn.Close()
+		<-finished
+		nodeDone <- nil
+	}()
+	body := fmt.Sprintf(`{"log":{"loglevel":"none"},"dns":{"hosts":{"example.com":"43.174.102.54"}},"outbounds":[{"tag":"proxy","protocol":"vks6","settings":{"address":"127.0.0.1","port":%d,"username":"vk-test","password":"0123456789abcdef"},"mux":{"enabled":false,"concurrency":-1}}]}`, port)
+	var config conf.Config
+	if err = json.Unmarshal([]byte(body), &config); err != nil {
+		t.Fatal(err)
+	}
+	compiled, err := config.Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance, err := core.New(compiled)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer instance.Close()
+	if err = instance.Start(); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	conn, err := core.Dial(ctx, instance, xnet.TCPDestination(xnet.DomainAddress("example.com"), 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+	roots := x509.NewCertPool()
+	roots.AddCert(website.Certificate())
+	tlsConn := tls.Client(conn, &tls.Config{RootCAs: roots, ServerName: "example.com", MinVersion: tls.VersionTLS12})
+	defer tlsConn.Close()
+	if err = tlsConn.HandshakeContext(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = io.WriteString(tlsConn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	response, err := http.ReadResponse(bufio.NewReader(tlsConn), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	got, err := io.ReadAll(response.Body)
+	if err != nil || response.StatusCode != 200 || string(got) != "native-vks6-body" {
+		t.Fatal(response.StatusCode, string(got), err)
+	}
+	_ = tlsConn.Close()
+	select {
+	case err = <-nodeDone:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("mock node did not terminate")
+	}
+	if err = instance.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
