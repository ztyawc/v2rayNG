diff --git a/proxy/vks6/client.go b/proxy/vks6/client.go
new file mode 100644
index 00000000..4601c153
--- /dev/null
+++ b/proxy/vks6/client.go
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: MPL-2.0
+package vks6
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/dice"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+// Client owns only in-flight TCP flows. There is no account/control connection,
+// listener, token refresh or SProxy/direct fallback. Close joins active flows.
+type Client struct {
+	config   *Config
+	policy   policy.Manager
+	fakeDNS  dns.FakeDNSEngine
+	mu       sync.Mutex
+	closed   bool
+	requests map[context.Context]context.CancelFunc
+	workers  sync.WaitGroup
+}
+
+func (c *Client) own(parent context.Context) (context.Context, func(), error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, nil, net.ErrClosed
+	}
+	if err := parent.Err(); err != nil {
+		return nil, nil, err
+	}
+	ctx, cancel := context.WithCancel(parent)
+	if c.requests == nil {
+		c.requests = make(map[context.Context]context.CancelFunc)
+	}
+	c.requests[ctx] = cancel
+	c.workers.Add(1)
+	return ctx, func() {
+		cancel()
+		c.mu.Lock()
+		delete(c.requests, ctx)
+		c.mu.Unlock()
+		c.workers.Done()
+	}, nil
+}
+
+func (c *Client) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	for _, cancel := range c.requests {
+		cancel()
+	}
+	c.mu.Unlock()
+	c.workers.Wait()
+	return nil
+}
+
+func (c *Client) Process(parent context.Context, link *transport.Link, dialer internet.Dialer) error {
+	obs := session.OutboundsFromContext(parent)
+	if len(obs) == 0 || !obs[len(obs)-1].Target.IsValid() {
+		return errors.New("vks6: target not specified")
+	}
+	ob := obs[len(obs)-1]
+	target := ob.Target
+	if target.Network != xnet.Network_TCP || !target.Address.Family().IsIPv4() {
+		return errors.New("vks6: only real IPv4 TCP targets are supported")
+	}
+	if engine, ok := c.fakeDNS.(dns.FakeDNSEngineRev0); ok && engine.IsIPInIPPool(target.Address) {
+		return errors.New("vks6: unresolved fake-IP target")
+	}
+	ip, ok := netip.AddrFromSlice(target.Address.IP())
+	if !ok {
+		return errors.New("vks6: invalid target address")
+	}
+	header, err := Header(c.config, netip.AddrPortFrom(ip.Unmap(), uint16(target.Port)))
+	if err != nil {
+		return err
+	}
+	ob.Name = "vks6"
+	ob.CanSpliceCopy = 3 // All bytes must pass through XOR, including native splice paths.
+	ctx, finish, err := c.own(parent)
+	if err != nil {
+		return err
+	}
+	defer finish()
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	p := c.policy.ForLevel(c.config.Level)
+	ctx = policy.ContextWithBufferPolicy(ctx, p.Buffer)
+	stopInput := context.AfterFunc(ctx, func() { _ = common.Interrupt(link.Reader) })
+	defer stopInput()
+
+	// Use the protected Xray dialer, including configured chaining and statistics.
+	// One fresh TCP flow chooses one port; rejection never tries a direct fallback.
+	port := c.config.Port + uint32(dice.Roll(int(c.config.endPort()-c.config.Port+1)))
+	node := xnet.TCPDestination(xnet.ParseAddress(c.config.Address), xnet.Port(port))
+	timeout := min(p.Timeouts.Handshake, 10*time.Second)
+	handshakeCtx, finishHandshake := context.WithTimeout(ctx, timeout)
+	defer finishHandshake()
+	conn, err := dialer.Dial(handshakeCtx, node)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	stopSocket := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stopSocket()
+	stopHandshake := context.AfterFunc(handshakeCtx, func() { _ = conn.Close() })
+	defer stopHandshake()
+	deadline, _ := handshakeCtx.Deadline()
+	if err := conn.SetDeadline(deadline); err != nil {
+		return err
+	}
+	if err := writeFull(conn, header); err != nil {
+		return err
+	}
+	var reply [2]byte
+	if _, err := io.ReadFull(conn, reply[:]); err != nil {
+		if handshakeCtx.Err() != nil {
+			return handshakeCtx.Err()
+		}
+		return err
+	}
+	if reply != [2]byte{6, 0} {
+		return errors.New("vks6: node rejected TCP connect")
+	}
+	// Consume exactly the two ACK bytes, preserving any coalesced target banner.
+	stopHandshake()
+	if err := handshakeCtx.Err(); err != nil {
+		return err
+	}
+	if err := conn.SetDeadline(time.Time{}); err != nil {
+		return err
+	}
+	finishHandshake()
+	timer := signal.CancelAfterInactivity(ctx, cancel, p.Timeouts.ConnectionIdle)
+	defer timer.SetTimeout(0)
+	stream := &xorConn{Conn: conn, key: 0x5a}
+	return relay(ctx, link, conn, func() error {
+		defer timer.SetTimeout(p.Timeouts.DownlinkOnly)
+		if err := buf.Copy(link.Reader, buf.NewWriter(stream), buf.UpdateActivity(timer)); err != nil {
+			return err
+		}
+		if half, ok := stat.TryUnwrapStatsConn(conn).(interface{ CloseWrite() error }); ok {
+			return half.CloseWrite()
+		}
+		return nil // Non-TCP chained transports finish by downlink/idle timeout.
+	}, func() error {
+		defer timer.SetTimeout(p.Timeouts.UplinkOnly)
+		return buf.Copy(buf.NewReader(stream), link.Writer, buf.UpdateActivity(timer))
+	})
+}
+
+func relay(ctx context.Context, link *transport.Link, conn net.Conn, up, down func() error) error {
+	var workers sync.WaitGroup
+	var responseDelivered atomic.Bool
+	results := make(chan error, 2)
+	defer func() {
+		_ = conn.Close()
+		_ = common.Interrupt(link.Reader)
+		if !responseDelivered.Load() {
+			_ = common.Interrupt(link.Writer)
+		}
+		workers.Wait()
+	}()
+	workers.Add(2)
+	go func() { defer workers.Done(); results <- up() }()
+	go func() {
+		defer workers.Done()
+		err := down()
+		if err == nil {
+			responseDelivered.Store(true)
+			err = common.Close(link.Writer)
+		}
+		results <- err
+	}()
+	for range 2 {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case err := <-results:
+			if err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func init() {
+	common.Must(common.RegisterConfig((*Config)(nil), func(ctx context.Context, raw interface{}) (interface{}, error) {
+		config := raw.(*Config)
+		if err := Validate(config); err != nil {
+			return nil, err
+		}
+		c := &Client{config: config}
+		err := core.RequireFeatures(ctx, func(pm policy.Manager) error { c.policy = pm; return nil })
+		if err == nil {
+			err = core.OptionalFeatures(ctx, func(engine dns.FakeDNSEngine) { c.fakeDNS = engine })
+		}
+		return c, err
+	}))
+}
