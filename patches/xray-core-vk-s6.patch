+// SPDX-License-Identifier: MPL-2.0
+package conf_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/infra/conf"
+	"github.com/xtls/xray-core/proxy/vks6"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func TestVkS6ConfigAndDefaultIpv4Resolution(t *testing.T) {
+	for _, ending := range []string{"", `,"portEnd":8150`} {
+		body := `{"protocol":"vks6","settings":{"address":"203.0.113.10","port":8050,"username":" vk-test ","password":" synthetic-secret "` + ending + `},"streamSettings":{"network":"tcp","tcpSettings":{"header":{ "type" : "none" }}}}`
+		var config conf.OutboundDetourConfig
+		if err := json.Unmarshal([]byte(body), &config); err != nil {
+			t.Fatal(err)
+		}
+		compiled, err := config.Build()
+		if err != nil {
+			t.Fatal(err)
+		}
+		proxy, err := compiled.ProxySettings.GetInstance()
+		if err != nil {
+			t.Fatal(err)
+		}
+		c := proxy.(*vks6.Config)
+		if c.Username != " vk-test " || c.Password != " synthetic-secret " {
+			t.Fatal("credential bytes changed")
+		}
+		if ending == "" && c.PortEnd != c.Port {
+			t.Fatal("fixed node port default lost")
+		}
+		if ending != "" && c.PortEnd != 8150 {
+			t.Fatal("port range lost")
+		}
+		sender, err := compiled.SenderSettings.GetInstance()
+		if err != nil || sender.(*proxyman.SenderConfig).TargetStrategy != internet.DomainStrategy_FORCE_IP4 {
+			t.Fatal("IPv4 DNS strategy missing", err)
+		}
+	}
+}
+
+func TestVkS6ConfigRejectsMissingInvalidAndUnsupportedParameters(t *testing.T) {
+	valid := map[string]any{"address": "203.0.113.10", "port": 8050, "username": "vk-test", "password": "synthetic-secret"}
+	for _, field := range []string{"address", "port", "username", "password"} {
+		m := make(map[string]any)
+		for k, v := range valid {
+			if k != field {
+				m[k] = v
+			}
+		}
+		body, _ := json.Marshal(m)
+		var c conf.VkS6Config
+		err := json.Unmarshal(body, &c)
+		if err == nil {
+			_, err = c.Build()
+		}
+		if err == nil {
+			t.Fatal("required field missing", field)
+		}
+	}
+	for field, values := range map[string][]any{
+		"address": {"node.test", "::1", "0.0.0.0", "224.0.0.1"},
+		"port":    {0, -1, 65536, 8050.5}, "portEnd": {0, -1, 8049, 65536, 8150.5},
+		"username": {""}, "password": {""}, "udp": {true}, "tls": {true}, "network": {"ws"},
+	} {
+		for _, value := range values {
+			m := make(map[string]any)
+			for k, v := range valid {
+				m[k] = v
+			}
+			m[field] = value
+			body, _ := json.Marshal(m)
+			var c conf.VkS6Config
+			err := json.Unmarshal(body, &c)
+			if err == nil {
+				_, err = c.Build()
+			}
+			if err == nil {
+				t.Fatal("invalid parameter accepted", field)
+			}
+		}
+	}
+	for _, extra := range []string{
+		`,"targetStrategy":"AsIs"`, `,"targetStrategy":"ForceIPv6"`,
+		`,"mux":{"enabled":true}`, `,"streamSettings":{"network":"ws"}`,
+		`,"streamSettings":{"security":"tls"}`, `,"streamSettings":{"tcpSettings":{"header":{"type":"http"}}}`,
+	} {
+		body := `{"protocol":"vks6","settings":{"address":"203.0.113.10","port":8050,"username":"vk-test","password":"synthetic-secret"}` + extra + `}`
+		var c conf.OutboundDetourConfig
+		err := json.Unmarshal([]byte(body), &c)
+		if err == nil {
+			_, err = c.Build()
+		}
+		if err == nil {
+			t.Fatal("unsupported transport accepted")
+		}
+	}
+}
+
+func TestVkS6PreservesTransportChainingWithoutExplicitStream(t *testing.T) {
+	var config conf.OutboundDetourConfig
+	if err := json.Unmarshal([]byte(`{"protocol":"vks6","settings":{"address":"203.0.113.10","port":8050,"username":"vk-test","password":"synthetic-secret"},"proxySettings":{"tag":"chain","transportLayer":true}}`), &config); err != nil {
+		t.Fatal(err)
+	}
+	compiled, err := config.Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := compiled.SenderSettings.GetInstance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sender := value.(*proxyman.SenderConfig)
+	if sender.StreamSettings.GetSocketSettings().GetDialerProxy() != "chain" {
+		t.Fatal("dialer proxy lost")
+	}
+}
+
+func TestVkS6ProtocolCaseCannotBypassResolutionOrTransportChecks(t *testing.T) {
+	for _, protocol := range []string{"vks6", "VKS6", "VkS6"} {
+		for _, extra := range []string{"", `,"mux":{"enabled":true}`, `,"streamSettings":{"security":"tls"}`} {
+			body := `{"protocol":"` + protocol + `","settings":{"address":"203.0.113.10","port":8050,"username":"vk-test","password":"synthetic-secret"}` + extra + `}`
+			var config conf.OutboundDetourConfig
+			if err := json.Unmarshal([]byte(body), &config); err != nil {
+				t.Fatal(err)
+			}
+			compiled, err := config.Build()
+			if extra != "" {
+				if err == nil {
+					t.Fatal("protocol case bypassed transport checks")
+				}
+				continue
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			sender, err := compiled.SenderSettings.GetInstance()
+			if err != nil || sender.(*proxyman.SenderConfig).TargetStrategy != internet.DomainStrategy_FORCE_IP4 {
+				t.Fatal("protocol case bypassed IPv4 resolution", err)
+			}
+		}
+	}
+}
