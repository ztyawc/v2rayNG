index 00000000..f05fa723
--- /dev/null
+++ b/proxy/vks6/wire.go
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MPL-2.0
+// VK Android 4.4.16's observed S6 IPv4/TCP download variant.
+package vks6
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"unicode/utf8"
+)
+
+var authKey = [...]byte{0x3c, 0x26, 0x44, 0x63, 0x4c, 0x2b, 0x43, 0x40}
+var defaultFakePool = netip.MustParsePrefix("198.18.0.0/15")
+
+func (c *Config) endPort() uint32 {
+	if c.PortEnd == 0 {
+		return c.Port
+	}
+	return c.PortEnd
+}
+
+func Validate(c *Config) error {
+	if c == nil || c.Port == 0 || c.Port > 65535 || c.endPort() < c.Port || c.endPort() > 65535 {
+		return errors.New("vks6: invalid node TCP port range")
+	}
+	ip, err := netip.ParseAddr(c.Address)
+	if err != nil || !ip.Is4() || ip.IsUnspecified() || ip.As4()[0] >= 224 {
+		return errors.New("vks6: a numeric unicast IPv4 node is required")
+	}
+	if !utf8.ValidString(c.Username) || !utf8.ValidString(c.Password) ||
+		len(c.Username) < 1 || len(c.Username) > 255 || len(c.Password) < 1 || len(c.Password) > 255 {
+		return errors.New("vks6: session credentials must contain 1-255 UTF-8 bytes")
+	}
+	return nil
+}
+
+// Header is the raw request. Each credential restarts the eight-byte XOR key;
+// neither the version/length bytes nor the destination are data-XORed.
+func Header(c *Config, target netip.AddrPort) ([]byte, error) {
+	if err := Validate(c); err != nil {
+		return nil, err
+	}
+	ip := target.Addr().Unmap()
+	if !ip.Is4() || target.Port() == 0 || defaultFakePool.Contains(ip) {
+		return nil, errors.New("vks6: a real IPv4 TCP destination is required")
+	}
+	out := make([]byte, 11+len(c.Username)+len(c.Password))
+	out[0], out[1] = 6, byte(len(c.Username))
+	i := 2
+	for n := range len(c.Username) {
+		out[i+n] = c.Username[n] ^ authKey[n%len(authKey)]
+	}
+	i += len(c.Username)
+	out[i] = byte(len(c.Password))
+	i++
+	for n := range len(c.Password) {
+		out[i+n] = c.Password[n] ^ authKey[n%len(authKey)]
+	}
+	i += len(c.Password)
+	out[i], out[i+1] = 9, 1
+	i += 2
+	ipv4 := ip.As4()
+	copy(out[i:i+4], ipv4[:])
+	binary.BigEndian.PutUint16(out[i+4:], target.Port())
+	return out, nil
+}
diff --git a/proxy/vks6/wire_test.go b/proxy/vks6/wire_test.go
