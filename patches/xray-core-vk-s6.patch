+++ b/proxy/vks6/wire_test.go
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: MPL-2.0
+package vks6
+
+import (
+	"encoding/hex"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func fixture() *Config {
+	return &Config{Address: "203.0.113.10", Port: 8050, PortEnd: 8150,
+		Username: "vk-test", Password: "0123456789abcdef"}
+}
+
+func TestHeaderCapturedFormatVector(t *testing.T) {
+	got, err := Header(fixture(), netip.MustParseAddrPort("43.174.102.54:80"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Independently calculated Python struct/socket vector published in the manual.
+	if hex.EncodeToString(got) != "06074a4d6917295837100c177650781e7577041f25012f4f262609012bae66360050" {
+		t.Fatal("request does not match independent vector")
+	}
+}
+
+func TestConfigAndCredentialByteBoundaries(t *testing.T) {
+	for _, length := range []int{1, 255} {
+		c := fixture()
+		c.Username, c.Password = strings.Repeat("x", length), strings.Repeat("y", length)
+		got, err := Header(c, netip.MustParseAddrPort("43.174.102.54:65535"))
+		if err != nil || len(got) != 11+2*length {
+			t.Fatal("valid byte length rejected", err)
+		}
+	}
+	c := fixture()
+	c.Username = strings.Repeat("中", 85)
+	if Validate(c) != nil {
+		t.Fatal("255 UTF-8 bytes rejected")
+	}
+	c.Username += "a"
+	if Validate(c) == nil {
+		t.Fatal("256 UTF-8 bytes accepted")
+	}
+	for _, mutate := range []func(*Config){
+		func(c *Config) { c.Port = 0 }, func(c *Config) { c.Port = 65536 },
+		func(c *Config) { c.PortEnd = 65536 }, func(c *Config) { c.PortEnd = 8049 },
+		func(c *Config) { c.Username = "" }, func(c *Config) { c.Password = "" },
+		func(c *Config) { c.Password = "\xff" }, func(c *Config) { c.Address = "node.example" },
+		func(c *Config) { c.Address = "::1" }, func(c *Config) { c.Address = "0.0.0.0" },
+		func(c *Config) { c.Address = "224.0.0.1" },
+	} {
+		c := fixture()
+		mutate(c)
+		if Validate(c) == nil {
+			t.Fatal("invalid configuration accepted")
+		}
+	}
+	c = fixture()
+	c.PortEnd = 0
+	if Validate(c) != nil || c.endPort() != c.Port {
+		t.Fatal("fixed port default lost")
+	}
+	for _, target := range []string{"[2001:db8::1]:80", "43.174.102.54:0", "198.18.0.1:80", "198.19.255.255:443"} {
+		if _, err := Header(fixture(), netip.MustParseAddrPort(target)); err == nil {
+			t.Fatal("invalid target accepted")
+		}
+	}
+}
