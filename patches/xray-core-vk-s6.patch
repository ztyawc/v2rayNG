@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MPL-2.0
+package vks6
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func TestNodeRejectionTruncatedReplyAndDeadline(t *testing.T) {
+	for _, mode := range []string{"reject", "wrong-version", "truncated", "timeout", "close"} {
+		t.Run(mode, func(t *testing.T) {
+			left, right := net.Pipe()
+			defer right.Close()
+			client := &Client{config: fixture(), policy: testPolicy{}}
+			defer client.Close()
+			entered := make(chan struct{})
+			serverDone := make(chan struct{})
+			go func() {
+				defer close(serverDone)
+				_, _, _ = readMockHeader(right, client.config)
+				close(entered)
+				switch mode {
+				case "reject":
+					_, _ = right.Write([]byte{6, 1})
+				case "wrong-version":
+					_, _ = right.Write([]byte{5, 0})
+				case "truncated":
+					_, _ = right.Write([]byte{6})
+					_ = right.Close()
+				}
+			}()
+			dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) { return left, nil }}
+			link, up, down := testLink()
+			defer up.Close()
+			defer down.Interrupt()
+			ctx, cancel := context.WithTimeout(testContext(xnet.TCPDestination(xnet.ParseAddress("43.174.102.54"), 80)), 200*time.Millisecond)
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- client.Process(ctx, link, dialer) }()
+			<-entered
+			if mode == "close" {
+				_ = client.Close()
+			}
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("failed handshake reported success")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("handshake did not terminate")
+			}
+			<-serverDone
+			if dialer.calls.Load() != 1 {
+				t.Fatal("node failure caused fallback")
+			}
+		})
+	}
+}
+
+func TestDialCancellationAndAlreadyCancelledFlow(t *testing.T) {
+	client := &Client{config: fixture(), policy: testPolicy{}}
+	defer client.Close()
+	ctx, cancel := context.WithCancel(testContext(xnet.TCPDestination(xnet.ParseAddress("43.174.102.54"), 80)))
+	entered := make(chan struct{})
+	dialer := &testDialer{work: func(ctx context.Context, _ xnet.Destination) (stat.Connection, error) {
+		close(entered)
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}}
+	link, up, down := testLink()
+	defer up.Close()
+	defer down.Interrupt()
+	done := make(chan error, 1)
+	go func() { done <- client.Process(ctx, link, dialer) }()
+	<-entered
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatal("dial cancellation lost", err)
+	}
+	if err := client.Process(ctx, link, dialer); !errors.Is(err, context.Canceled) {
+		t.Fatal("cancelled flow admitted", err)
+	}
+	if dialer.calls.Load() != 1 {
+		t.Fatal("cancelled context dialed")
+	}
+}
+
+// Ensure writeFull reports a writer that cannot make progress without spinning.
+func TestHeaderShortWrite(t *testing.T) {
+	writer := &shortConn{max: 2}
+	header := []byte{6, 7, 1, 2, 3, 4, 5}
+	if err := writeFull(writer, header); err != nil || writer.Len() != len(header) {
+		t.Fatal("short header write", err)
+	}
+	writer.zero = true
+	if err := writeFull(writer, header); !errors.Is(err, io.ErrShortWrite) {
+		t.Fatal("zero header write accepted")
+	}
+}
+
+func TestCloseCancelsActiveRelayAndJoinsBothDirections(t *testing.T) {
+	left, right := net.Pipe()
+	defer right.Close()
+	client := &Client{config: fixture(), policy: testPolicy{}}
+	defer client.Close()
+	serverDone := make(chan struct{})
+	go func() {
+		defer close(serverDone)
+		_, _, _ = readMockHeader(right, client.config)
+		_, _ = right.Write([]byte{6, 0, 'B' ^ 0x5a})
+		_, _ = io.Copy(io.Discard, right)
+	}()
+	dialer := &testDialer{work: func(context.Context, xnet.Destination) (stat.Connection, error) { return left, nil }}
+	link, up, down := testLink()
+	defer up.Close()
+	defer down.Interrupt()
+	done := make(chan error, 1)
+	go func() {
+		done <- client.Process(testContext(xnet.TCPDestination(xnet.ParseAddress("43.174.102.54"), 80)), link, dialer)
+	}()
+	reader := &buf.BufferedReader{Reader: down}
+	var banner [1]byte
+	if _, err := io.ReadFull(reader, banner[:]); err != nil || banner[0] != 'B' {
+		t.Fatal("relay did not start", err)
+	}
+	closed := make(chan struct{})
+	go func() { _ = client.Close(); _ = client.Close(); close(closed) }()
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("active relay did not join")
+	}
+	if err := <-done; err == nil {
+		t.Fatal("cancelled relay reported success")
+	}
+	<-serverDone
+}
