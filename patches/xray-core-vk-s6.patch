index 00000000..0e4cbacc
--- /dev/null
+++ b/infra/conf/vks6.go
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: MPL-2.0
+package conf
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/proxy/vks6"
+	"github.com/xtls/xray-core/transport/internet"
+	"google.golang.org/protobuf/proto"
+)
+
+type VkS6Config struct {
+	Address  string  `json:"address"`
+	Port     uint32  `json:"port"`
+	PortEnd  *uint32 `json:"portEnd"`
+	Username string  `json:"username"`
+	Password string  `json:"password"`
+	Level    uint32  `json:"level"`
+	UDP      bool    `json:"udp"`
+	TLS      bool    `json:"tls"`
+	Network  string  `json:"network"`
+}
+
+func (c *VkS6Config) Build() (proto.Message, error) {
+	if c.UDP || c.TLS || c.Network != "" && c.Network != "tcp" {
+		return nil, errors.New("vks6: only plain TCP is supported")
+	}
+	end := c.Port
+	if c.PortEnd != nil {
+		end = *c.PortEnd
+		if end == 0 {
+			return nil, errors.New("vks6: portEnd must be a valid TCP port")
+		}
+	}
+	out := &vks6.Config{Address: c.Address, Port: c.Port, PortEnd: end,
+		Username: c.Username, Password: c.Password, Level: c.Level}
+	return out, vks6.Validate(out)
+}
+
+// Resolve through Xray's existing DNS owner (with FakeEnable=false), preserving
+// hosts, routing and Android socket protection. Never send a domain in S6 framing.
+func (c *OutboundDetourConfig) configureVkS6(sender *proxyman.SenderConfig) error {
+	if c.TargetStrategy != "" && !strings.EqualFold(c.TargetStrategy, "ForceIPv4") {
+		return errors.New("vks6: targetStrategy must be ForceIPv4")
+	}
+	sender.TargetStrategy = internet.DomainStrategy_FORCE_IP4
+	if sender.MultiplexSettings != nil && sender.MultiplexSettings.Enabled {
+		return errors.New("vks6: mux is not supported")
+	}
+	if stream := sender.StreamSettings; stream != nil {
+		if (stream.ProtocolName != "" && stream.ProtocolName != "tcp") || stream.SecurityType != "" {
+			return errors.New("vks6: only plain TCP transport is supported")
+		}
+	}
+	if source := c.StreamSetting; source != nil {
+		if source.FinalMask != nil {
+			return errors.New("vks6: outer masks are not supported")
+		}
+		for _, tcp := range []*TCPConfig{source.TCPSettings, source.RAWSettings} {
+			if tcp != nil && len(tcp.HeaderConfig) != 0 {
+				var header struct {
+					Type string `json:"type"`
+				}
+				if json.Unmarshal(tcp.HeaderConfig, &header) != nil || header.Type != "none" {
+					return errors.New("vks6: TCP header camouflage is not supported")
+				}
+			}
+		}
+	}
+	return nil
+}
diff --git a/infra/conf/vks6_core_test.go b/infra/conf/vks6_core_test.go
