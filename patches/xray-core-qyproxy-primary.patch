+// SPDX-License-Identifier: GPL-3.0-only
+package qyproxy
+
+import (
+	"bytes"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+func TestRoleUDPFrameBudgets(t *testing.T) {
+	for _, test := range []struct {
+		role string
+		code byte
+		max  int
+	}{{Primary, 7, 1390}, {CN2, 5, 1190}, {CN2Download, 5, 1190}} {
+		t.Run(test.role, func(t *testing.T) {
+			n := newTestNode(t, test.role, test.code)
+			client := n.client(t)
+			conn, err := client.ListenPacket(t.Context())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			target := &net.UDPAddr{IP: net.IPv4(192, 0, 2, 5), Port: 3478}
+			payload := bytes.Repeat([]byte{0x5a}, test.max)
+			if size, err := conn.WriteTo(payload, target); err != nil || size != len(payload) {
+				t.Fatal("largest unfragmented UDP payload rejected", size, err)
+			}
+			got := make([]byte, len(payload))
+			size, from, err := conn.ReadFrom(got)
+			if err != nil || size != len(payload) || from.String() != target.String() || !bytes.Equal(got, payload) {
+				t.Fatal("largest UDP payload changed", size, err)
+			}
+			if _, err := conn.WriteTo(append(payload, 0), target); !errors.Is(err, ErrOversize) {
+				t.Fatal("oversize UDP payload did not fail explicitly", err)
+			}
+		})
+	}
+}
+
+func TestPrimaryDNSPrefixConsumesFrameBudget(t *testing.T) {
+	n := newTestNode(t, Primary, 7)
+	client := n.client(t)
+	conn, err := client.ListenPacket(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	query := new(dns.Msg)
+	query.SetQuestion("budget.example.test.", dns.TypeA)
+	query.Id = 42
+	padding := &dns.EDNS0_PADDING{}
+	query.Extra = []dns.RR{&dns.OPT{Hdr: dns.RR_Header{Name: ".", Rrtype: dns.TypeOPT, Class: 4096}, Option: []dns.EDNS0{padding}}}
+	wire, err := query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The primary IPv4 frame has a ten-byte header and a 01/length/area DNS prefix.
+	limit := 1400 - 10 - 2 - len(n.o.GameArea)
+	padding.Padding = make([]byte, limit-len(wire))
+	wire, err = query.Pack()
+	if err != nil || len(wire) != limit {
+		t.Fatal("invalid boundary DNS fixture", len(wire), err)
+	}
+	target := &net.UDPAddr{IP: net.IPv4(8, 8, 8, 8), Port: 53}
+	if size, err := conn.WriteTo(wire, target); err != nil || size != limit {
+		t.Fatal("boundary primary DNS query rejected", size, err)
+	}
+	buffer := make([]byte, 4096)
+	size, from, err := conn.ReadFrom(buffer)
+	if err != nil || from.String() != target.String() {
+		t.Fatal("primary DNS resolver endpoint lost", err)
+	}
+	var reply dns.Msg
+	if err := reply.Unpack(buffer[:size]); err != nil || reply.Id != 42 || !reply.Response {
+		t.Fatal("primary DNS transaction was not restored", err)
+	}
+	padding.Padding = append(padding.Padding, 0)
+	wire, err = query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.WriteTo(wire, target); !errors.Is(err, ErrOversize) {
+		t.Fatal("DNS area prefix escaped the frame budget", err)
+	}
+	pc := conn.(*packetConn)
+	pc.mu.Lock()
+	pending := len(pc.pending)
+	pc.mu.Unlock()
+	if pending != 0 {
+		t.Fatal("oversize DNS request retained pending state")
+	}
+}
+
+func TestPrimaryDNSDoesNotFallBackWithoutNegotiatedEndpoint(t *testing.T) {
+	conn := &packetConn{opts: testOptions(), g: &generation{}}
+	query := new(dns.Msg)
+	query.SetQuestion("missing-dns.example.test.", dns.TypeA)
+	wire, err := query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := conn.WriteTo(wire, &net.UDPAddr{IP: net.IPv4(8, 8, 8, 8), Port: 53}); err == nil {
+		t.Fatal("primary silently used a resolver not supplied by the node")
+	}
+}
