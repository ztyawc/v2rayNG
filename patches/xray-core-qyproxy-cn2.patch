+	udp := n.udp.LocalAddr().(*net.UDPAddr).Port
+	ack := []byte{3, 4, 4, 5, 4, 6, byte(tcp >> 8), byte(tcp), byte(udp >> 8), byte(udp)}
+	challenge := []byte{3, 'a', 'b', 'c'}
+	_, e = s.Write(append(frame(1, 2, 0, ack), frame(4, 1, 17, challenge)...))
+	if e != nil {
+		return
+	}
+	response, e := readFrame(s)
+	if e != nil {
+		return
+	}
+	want := md5.Sum(append([]byte{17}, []byte("test-secretabc")...))
+	if len(response) < 22 || response[0] != 4 || response[1] != 2 || response[2] != 17 || response[5] != 16 || !bytes.Equal(response[6:22], want[:]) || string(response[22:]) != "test-user&20&456&test-device" {
