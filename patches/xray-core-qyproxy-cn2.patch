+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/policy"
+	qt "github.com/xtls/xray-core/proxy/qyproxy/transport"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+type testPolicy struct{}
+
+func (testPolicy) Type() interface{}              { return policy.ManagerType() }
+func (testPolicy) Start() error                   { return nil }
+func (testPolicy) Close() error                   { return nil }
+func (testPolicy) ForLevel(uint32) policy.Session { return policy.SessionDefault() }
+func (testPolicy) ForSystem() policy.System       { return policy.System{} }
+
+type testDialer struct{ t *testing.T }
+
+func (d testDialer) Dial(ctx context.Context, dest xnet.Destination) (stat.Connection, error) {
+	obs := session.OutboundsFromContext(ctx)
+	if len(obs) != 1 || obs[0].Target != dest || obs[0].Name != "qyproxy" {
+		d.t.Error("socket did not receive isolated outbound metadata")
+	}
+	address := fmt.Sprintf("%s:%d", dest.Address.String(), dest.Port)
+	if dest.Network == xnet.Network_UDP {
+		remote, err := net.ResolveUDPAddr("udp4", address)
+		if err != nil {
+			return nil, err
+		}
+		conn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+		if err != nil {
+			return nil, err
+		}
+		return &stat.CounterConnection{Connection: &internet.PacketConnWrapper{PacketConn: conn, Dest: remote}}, nil
+	}
+	conn, err := (&net.Dialer{}).DialContext(ctx, dest.Network.SystemString(), address)
+	if err != nil {
+		return nil, err
+	}
+	return &stat.CounterConnection{Connection: conn}, nil
+}
+func (testDialer) DestIpAddress() xnet.IP                                { return nil }
