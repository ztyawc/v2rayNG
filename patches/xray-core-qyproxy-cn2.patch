+		return
+	}
+	n.logins.Add(1)
+	_, e = s.Write(frame(4, 5, 17, append([]byte{0, 0, 16}, n.token...)))
+	if e != nil {
+		return
+	}
+	defer n.once.Do(func() { close(n.controlGone) })
+	for {
+		m, e := readFrame(s)
+		if e != nil {
+			return
+		}
+		if m[0] != 1 || m[1] != 7 {
+			n.t.Error("heartbeat framing")
