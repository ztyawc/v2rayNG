+// SPDX-License-Identifier: GPL-3.0-only
+package conf
+
+import (
+	"encoding/json"
+	"github.com/xtls/xray-core/proxy/qyproxy"
+	"testing"
+)
+
+func TestQyProxyConfig(t *testing.T) {
+	for _, role := range []string{"cn2", "cn2_download"} {
+		c := QyProxyConfig{Address: "198.51.100.7", Port: 7025, User: "test-user", Password: "test-secret", Role: role, SN: "test-device", GameID: 456, ServerID: 123, GameArea: "hk"}
+		out, err := c.Build()
+		if err != nil {
+			t.Fatal(err)
+		}
+		config := out.(*qyproxy.Config)
+		if config.Role != role || config.GameId != 456 || config.ServerId != 123 || config.Password != "test-secret" {
+			t.Fatal("negotiation fields lost")
+		}
+		c.Role = "primary"
+		if _, err = c.Build(); err == nil {
+			t.Fatal("unsupported role accepted")
+		}
+		c.Role = role
+		c.Port = 65536
+		if _, err = c.Build(); err == nil {
+			t.Fatal("control port wrapped")
+		}
+		c.Port = 7025
+		c.SN = ""
+		if _, err = c.Build(); err == nil {
+			t.Fatal("missing SN accepted")
+		}
+	}
+	for _, body := range []string{`{"gameId":4294967296}`, `{"serverId":-1}`} {
+		if err := json.Unmarshal([]byte(body), new(QyProxyConfig)); err == nil {
+			t.Fatal("out-of-range uint accepted")
+		}
+	}
+}
