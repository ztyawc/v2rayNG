diff --git a/proxy/qyproxy/config.proto b/proxy/qyproxy/config.proto
new file mode 100644
--- /dev/null
+++ b/proxy/qyproxy/config.proto
@@ -0,0 +1,21 @@
+syntax = "proto3";
+
+package xray.proxy.qyproxy;
+option go_package = "github.com/xtls/xray-core/proxy/qyproxy";
+
+message Config {
+  string address = 1;
+  uint32 port = 2;
+  string user = 3;
+  string password = 4;
+  string role = 5;
+  string sn = 6;
+  uint32 game_id = 7;
+  uint32 server_id = 8;
+  uint32 client_type = 9;
+  string game_area = 10;
+  string zone = 11;
+  string product = 12;
+  string client_version = 13;
+  uint32 level = 14;
+}
