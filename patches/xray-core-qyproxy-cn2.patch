+		common.Close(down)
+		done <- err
+	}()
+	var reply bytes.Buffer
+	if err := buf.Copy(output, buf.NewWriter(&reply)); err != nil {
+		t.Fatal("server FIN must close the output after preserving queued reply:", err)
+	}
+	if reply.String() != "server-first" {
+		t.Fatal("server reply dropped at FIN")
+	}
+	client.Close()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("request worker remained blocked after Close")
+	}
