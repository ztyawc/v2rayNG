+++ b/proxy/qyproxy/client.go
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Xray integration for the QyProxy CN2 transport; see transport/NOTICE.
+package qyproxy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	xerrors "github.com/xtls/xray-core/common/errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	qt "github.com/xtls/xray-core/proxy/qyproxy/transport"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+// Client owns one role's shared control generation and all in-flight requests.
+// UDP dispatch can detach caller cancellation, so Close also cancels and joins
+// requests before the native outbound is destroyed.
+type Client struct {
+	config   *Config
+	policy   policy.Manager
+	mu       sync.Mutex
+	closed   bool
+	control  *qt.Client
+	requests map[context.Context]context.CancelFunc
+	workers  sync.WaitGroup
+}
+
+func Options(config *Config) (qt.Options, error) {
+	if config == nil || config.Port == 0 || config.Port > 65535 || (config.Role != qt.CN2 && config.Role != qt.CN2Download) {
+		return qt.Options{}, errors.New("qyproxy: valid control port and cn2/cn2_download role required")
+	}
+	o := qt.Options{Server: config.Address, Port: uint16(config.Port), Role: config.Role,
+		Username: config.User, Password: config.Password, SN: config.Sn,
+		GameID: config.GameId, ServerID: config.ServerId, ClientType: config.ClientType,
+		GameArea: config.GameArea, Zone: config.Zone, Product: config.Product, Version: config.ClientVersion}
+	return o, o.Validate()
+}
+
+func (c *Client) own(parent context.Context, dialer internet.Dialer, tag string) (context.Context, *qt.Client, func(), error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, nil, nil, qt.ErrClosed
+	}
+	if c.control == nil {
+		o, err := Options(c.config)
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		control, err := qt.New(o, &nativeDialer{dialer: dialer, tag: tag}, resolveNode, func(message string) {
+			xerrors.LogInfo(context.Background(), "qyproxy control role=", o.Role, " outbound=", tag, " ", message)
+		})
+		if err != nil {
+			return nil, nil, nil, err
+		}
+		c.control = control
+	}
+	ctx, cancel := context.WithCancel(parent)
+	if c.requests == nil {
+		c.requests = make(map[context.Context]context.CancelFunc)
+	}
+	c.requests[ctx] = cancel
+	c.workers.Add(1)
+	return ctx, c.control, func() {
+		cancel()
+		c.mu.Lock()
+		delete(c.requests, ctx)
+		c.mu.Unlock()
+		c.workers.Done()
+	}, nil
+}
+
+func (c *Client) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	for _, cancel := range c.requests {
+		cancel()
+	}
+	control := c.control
+	c.mu.Unlock()
+	if control != nil {
+		_ = control.Close()
+	}
+	c.workers.Wait()
+	return nil
+}
+
+func resolveNode(ctx context.Context, host string) (netip.Addr, error) {
+	if ip, err := netip.ParseAddr(host); err == nil {
+		return ip.Unmap(), nil
+	}
+	ips, err := net.DefaultResolver.LookupNetIP(ctx, "ip4", host)
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	if len(ips) == 0 {
+		return netip.Addr{}, errors.New("qyproxy: node has no IPv4 address")
+	}
+	return ips[0].Unmap(), nil
+}
+
+// Each socket gets fresh outbound metadata: shared control/data dials must not
+// race on the mutable metadata of the first request. The Xray dialer retains
+// socket protection, sockopt, statistics and configured proxy chaining.
+type nativeDialer struct {
+	dialer internet.Dialer
+	tag    string
+}
+
+func (d *nativeDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	dest, err := xnet.ParseDestination(network + ":" + address)
+	if err != nil {
+		return nil, err
+	}
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dest, Tag: d.tag, Name: "qyproxy"}})
+	conn, err := d.dialer.Dial(ctx, dest)
+	if err != nil {
+		return nil, err
+	}
+	if network == "tcp" {
+		return &halfCloseConn{Conn: conn}, nil
+	}
+	return conn, nil
+}
+
+// Statistics wrappers do not expose TCP half-close. Keep accounting on reads
+// and writes while forwarding FIN through their underlying socket. Chained
+// transports without half-close remain open for the normal downlink timeout.
+type halfCloseConn struct{ net.Conn }
+
+func (c *halfCloseConn) CloseWrite() error {
+	raw := stat.TryUnwrapStatsConn(c.Conn)
+	if conn, ok := raw.(interface{ CloseWrite() error }); ok {
+		return conn.CloseWrite()
+	}
+	return nil
+}
+func (c *halfCloseConn) CloseRead() error {
+	raw := stat.TryUnwrapStatsConn(c.Conn)
+	if conn, ok := raw.(interface{ CloseRead() error }); ok {
+		return conn.CloseRead()
+	}
+	return nil
+}
+func (d *nativeDialer) ListenPacket(ctx context.Context, network, local string, remote netip.AddrPort) (net.PacketConn, error) {
+	conn, err := d.DialContext(ctx, network, remote.String())
+	if err != nil {
+		return nil, err
+	}
+	return &connectedPacket{Conn: conn, remote: remote}, nil
+}
+
+type connectedPacket struct {
+	net.Conn
+	remote netip.AddrPort
+}
+
+func (p *connectedPacket) ReadFrom(b []byte) (int, net.Addr, error) {
+	// Xray's default UDP dialer is a PacketConnWrapper around an unconnected
+	// socket. Preserve its actual source address so transport validates the
+	// node port; treating every incoming packet as the configured peer would
+	// accept a forged handshake ACK. Keep the statistics wrapper accounting.
+	if raw, ok := stat.TryUnwrapStatsConn(p.Conn).(interface {
+		ReadFrom([]byte) (int, net.Addr, error)
+	}); ok {
+		n, from, err := raw.ReadFrom(b)
+		if counted, ok := p.Conn.(*stat.CounterConnection); ok && counted.ReadCounter != nil {
+			counted.ReadCounter.Add(int64(n))
+		}
+		return n, from, err
+	}
+	// Stream-based proxy chains expose a connection to this fixed destination.
+	n, err := p.Conn.Read(b)
+	return n, net.UDPAddrFromAddrPort(p.remote), err
+}
+func (p *connectedPacket) WriteTo(b []byte, a net.Addr) (int, error) {
+	ap, err := netip.ParseAddrPort(a.String())
+	if err != nil || ap != p.remote {
+		return 0, errors.New("qyproxy: unexpected UDP relay")
+	}
+	return p.Conn.Write(b)
+}
+
+func (c *Client) Process(parent context.Context, link *transport.Link, dialer internet.Dialer) error {
+	obs := session.OutboundsFromContext(parent)
+	if len(obs) == 0 || !obs[len(obs)-1].Target.IsValid() {
+		return errors.New("qyproxy: target not specified")
+	}
+	ob := obs[len(obs)-1]
+	ob.Name = "qyproxy"
+	ob.CanSpliceCopy = 0
+	target := ob.Target
+	if target.Network != xnet.Network_TCP && target.Network != xnet.Network_UDP {
+		return errors.New("qyproxy: unsupported target network")
+	}
+	ctx, control, finish, err := c.own(parent, dialer, ob.Tag)
+	if err != nil {
+		return err
+	}
+	defer finish()
+	linkStopped := make(chan struct{})
+	stopLink := context.AfterFunc(ctx, func() { defer close(linkStopped); _ = common.Interrupt(link.Reader); _ = common.Interrupt(link.Writer) })
+	defer func() {
+		if !stopLink() {
+			<-linkStopped
+		}
+	}()
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	p := c.policy.ForLevel(c.config.Level)
+	timer := signal.CancelAfterInactivity(ctx, cancel, p.Timeouts.ConnectionIdle)
+	defer timer.SetTimeout(0)
+	if target.Network == xnet.Network_TCP {
+		ip, err := resolveDestination(ctx, control, target.Address)
+		if err != nil {
+			return err
+		}
+		conn, err := control.DialContext(ctx, netip.AddrPortFrom(ip, uint16(target.Port)))
+		if err != nil {
+			return err
+		}
+		defer conn.Close()
+		return relay(ctx, link, conn.Close, func() error {
+			defer timer.SetTimeout(p.Timeouts.DownlinkOnly)
+			err := buf.Copy(link.Reader, buf.NewWriter(conn), buf.UpdateActivity(timer))
+			if err == nil {
+				err = conn.(interface{ CloseWrite() error }).CloseWrite()
+			}
+			return err
+		}, func() error {
+			defer timer.SetTimeout(p.Timeouts.UplinkOnly)
+			return buf.Copy(buf.NewReader(conn), link.Writer, buf.UpdateActivity(timer))
+		})
+	}
+	pc, err := control.ListenPacket(ctx)
+	if err != nil {
+		return err
+	}
+	defer pc.Close()
+	return relay(ctx, link, pc.Close, func() error {
+		defer timer.SetTimeout(p.Timeouts.DownlinkOnly)
+		return buf.Copy(link.Reader, &packetWriter{ctx: ctx, conn: pc, client: control, target: target}, buf.UpdateActivity(timer))
+	}, func() error {
+		defer timer.SetTimeout(p.Timeouts.UplinkOnly)
+		return buf.Copy(&packetReader{conn: pc}, link.Writer, buf.UpdateActivity(timer))
+	})
+}
+
+func relay(ctx context.Context, link *transport.Link, closeSocket func() error, up, down func() error) error {
+	var wg sync.WaitGroup
+	results := make(chan error, 2)
+	failed := true
+	var responseComplete atomic.Bool
+	defer func() {
+		_ = closeSocket()
+		_ = common.Interrupt(link.Reader)
+		if failed && !responseComplete.Load() {
+			_ = common.Interrupt(link.Writer)
+		}
+		wg.Wait()
+	}()
+	for index, work := range []func() error{up, down} {
+		wg.Add(1)
+		go func(f func() error, response bool) {
+			defer wg.Done()
+			err := f()
+			if response && err == nil {
+				// Deliver buffered data and FIN as soon as the server finishes,
+				// even while the client keeps its sending direction open. A
+				// later uplink timeout must not discard this queued reply.
+				responseComplete.Store(true)
+				_ = common.Close(link.Writer)
+			}
+			results <- err
+		}(work, index == 1)
+	}
+	for n := 0; n < 2; n++ {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case err := <-results:
+			if err != nil {
+				return err
+			}
+		}
+	}
+	failed = false
+	return nil
+}
+
+type packetWriter struct {
+	ctx    context.Context
+	conn   net.PacketConn
+	client *qt.Client
+	target xnet.Destination
+}
+
+func (w *packetWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		target := w.target
+		if b.UDP != nil {
+			target = *b.UDP
+		}
+		ip, err := resolveDestination(w.ctx, w.client, target.Address)
+		if err != nil {
+			return err
+		}
+		n, err := w.conn.WriteTo(b.Bytes(), net.UDPAddrFromAddrPort(netip.AddrPortFrom(ip, uint16(target.Port))))
+		if err != nil {
+			return err
+		}
+		if n != int(b.Len()) {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+type packetReader struct{ conn net.PacketConn }
+
+func resolveDestination(ctx context.Context, client *qt.Client, address xnet.Address) (netip.Addr, error) {
+	if address == nil {
+		return netip.Addr{}, qt.ErrProtocol
+	}
+	if address.Family().IsIP() {
+		ip, ok := netip.AddrFromSlice(address.IP())
+		if !ok || !ip.Unmap().Is4() {
+			return netip.Addr{}, qt.ErrIPv6
+		}
+		return ip.Unmap(), nil
+	}
+	return client.Resolve(ctx, address.Domain())
+}
+
+func (r *packetReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	b := buf.NewWithSize(65536)
+	n, addr, err := r.conn.ReadFrom(b.Extend(65536))
+	if err != nil {
+		b.Release()
+		return nil, err
+	}
+	b.Resize(0, int32(n))
+	ap, err := netip.ParseAddrPort(addr.String())
+	if err != nil {
+		b.Release()
+		return nil, err
+	}
+	dest := xnet.UDPDestination(xnet.IPAddress(ap.Addr().AsSlice()), xnet.Port(ap.Port()))
+	b.UDP = &dest
+	return buf.MultiBuffer{b}, nil
+}
+
+func init() {
+	common.Must(common.RegisterConfig((*Config)(nil), func(ctx context.Context, raw interface{}) (interface{}, error) {
+		config := raw.(*Config)
+		if _, err := Options(config); err != nil {
+			return nil, err
+		}
+		c := &Client{config: config}
+		err := core.RequireFeatures(ctx, func(pm policy.Manager) error { c.policy = pm; return nil })
+		return c, err
+	}))
+}
