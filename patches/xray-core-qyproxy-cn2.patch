+// SPDX-License-Identifier: GPL-3.0-only
+package conf
+
+import (
+	"github.com/xtls/xray-core/proxy/qyproxy"
+	"google.golang.org/protobuf/proto"
+)
+
+type QyProxyConfig struct {
+	Address       string `json:"address"`
+	Port          uint32 `json:"port"`
+	User          string `json:"user"`
+	Password      string `json:"password"`
+	Role          string `json:"role"`
+	SN            string `json:"sn"`
+	GameID        uint32 `json:"gameId"`
+	ServerID      uint32 `json:"serverId"`
+	ClientType    uint32 `json:"clientType"`
+	GameArea      string `json:"gameArea"`
+	Zone          string `json:"zone"`
+	Product       string `json:"product"`
+	ClientVersion string `json:"clientVersion"`
+	Level         uint32 `json:"level"`
+}
+
+func (c *QyProxyConfig) Build() (proto.Message, error) {
+	out := &qyproxy.Config{Address: c.Address, Port: c.Port, User: c.User, Password: c.Password, Role: c.Role,
+		Sn: c.SN, GameId: c.GameID, ServerId: c.ServerID, ClientType: c.ClientType, GameArea: c.GameArea,
+		Zone: c.Zone, Product: c.Product, ClientVersion: c.ClientVersion, Level: c.Level}
+	if _, err := qyproxy.Options(out); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
