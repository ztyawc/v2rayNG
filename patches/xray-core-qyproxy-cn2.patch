+				common.Close(down)
+				done <- e
+			}()
+			for i := 0; i < 2; i++ {
+				b := buf.New()
+				b.Write([]byte{1, 2, 3, byte(i)})
+				dest := xnet.UDPDestination(xnet.ParseAddress(fmt.Sprintf("192.0.2.%d", i+5)), xnet.Port(3478+i))
