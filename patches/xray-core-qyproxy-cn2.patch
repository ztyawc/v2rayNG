+// SPDX-License-Identifier: GPL-3.0-only
+package conf_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/infra/conf"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"testing"
+)
+
+// Exercise JSON loading, protobuf registration, native factory creation and
+// core-owned Close together. Authentication remains lazy until the first flow.
+func TestQyProxyCoreConfig(t *testing.T) {
+	for _, role := range []string{"cn2", "cn2_download"} {
+		t.Run(role, func(t *testing.T) {
+			body := fmt.Sprintf(`{"log":{"loglevel":"none"},"outbounds":[{"tag":"proxy","protocol":"qyproxy","settings":{"address":"198.51.100.7","port":7025,"user":"test-user","password":"test-secret","role":%q,"sn":"test-device","gameId":456,"serverId":123,"gameArea":"hk"},"mux":{"enabled":false}}]}`, role)
+			var config conf.Config
+			if err := json.Unmarshal([]byte(body), &config); err != nil {
+				t.Fatal(err)
+			}
+			compiled, err := config.Build()
+			if err != nil {
+				t.Fatal(err)
+			}
+			instance, err := core.New(compiled)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer instance.Close()
+			if err := instance.Start(); err != nil {
+				t.Fatal(err)
+			}
+			manager := instance.GetFeature(outbound.ManagerType()).(outbound.Manager)
+			if manager.GetHandler("proxy") == nil {
+				t.Fatal("new native outbound not registered")
+			}
+			if err := instance.Close(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
