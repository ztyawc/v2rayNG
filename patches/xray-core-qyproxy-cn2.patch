+				t.Fatal("TCP ACK/payload boundaries or XOR stream offsets")
+			}
+			up, input = pipe.New()
+			output, down = pipe.New()
+			target = xnet.UDPDestination(xnet.ParseAddress("192.0.2.5"), 3478)
+			request = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target, Tag: "fixture"}})
+			go func() {
