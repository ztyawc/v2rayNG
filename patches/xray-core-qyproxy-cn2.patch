@@ -0,0 +1,573 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from ztyawc/mihomo-cn2 at 0d09a3da4fc9b9c400a33bbd6b0e04c6543d362a.
+package qyproxy
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+type Dialer interface {
+	DialContext(context.Context, string, string) (net.Conn, error)
+	ListenPacket(context.Context, string, string, netip.AddrPort) (net.PacketConn, error)
+}
+
+// Client owns one control session shared by its data connections. Authentication
+// is lazy and independent of any single waiting request's cancellation.
+type Client struct {
+	opts            Options
+	dialer          Dialer
+	resolveServer   func(context.Context, string) (netip.Addr, error)
+	log             func(string)
+	ctx             context.Context
+	cancel          context.CancelFunc
+	mu              sync.Mutex
+	changed         chan struct{}
+	started, closed bool
+	terminal        error
+	current         *generation
+	wg              sync.WaitGroup
+	timeout         time.Duration
+	retryDelays     []time.Duration
+}
+
+type generation struct {
+	control          net.Conn
+	ip               netip.Addr
+	config           negotiated
+	token            [16]byte
+	mu               sync.Mutex
+	closed           bool
+	sockets          map[io.Closer]struct{}
+	tcpNext, udpNext int
+	cache            map[string]dnsCache
+}
+
+func New(o Options, d Dialer, resolve func(context.Context, string) (netip.Addr, error), log func(string)) (*Client, error) {
+	if err := o.normalize(); err != nil {
+		return nil, err
+	}
+	if d == nil || resolve == nil {
+		return nil, errors.New("qyproxy: missing dialer or server resolver")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	if log == nil {
+		log = func(string) {}
+	}
+	return &Client{opts: o, dialer: d, resolveServer: resolve, log: log, ctx: ctx, cancel: cancel, changed: make(chan struct{}), timeout: 12 * time.Second, retryDelays: []time.Duration{2 * time.Second, 5 * time.Second, 10 * time.Second}}, nil
+}
+func (c *Client) notifyLocked() { close(c.changed); c.changed = make(chan struct{}) }
+func (c *Client) get(ctx context.Context) (*generation, error) {
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.mu.Lock()
+		if c.closed {
+			c.mu.Unlock()
+			return nil, ErrClosed
+		}
+		if c.terminal != nil {
+			err := c.terminal
+			c.mu.Unlock()
+			return nil, err
+		}
+		if c.current != nil {
+			g := c.current
+			c.mu.Unlock()
+			return g, nil
+		}
+		if !c.started {
+			c.started = true
+			c.wg.Add(1)
+			go c.run()
+		}
+		ch := c.changed
+		c.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-ch:
+		}
+	}
+}
+func (c *Client) run() {
+	defer c.wg.Done()
+	attempt := 0
+	for {
+		g, err := c.login()
+		if err != nil {
+			if c.ctx.Err() != nil {
+				return
+			}
+			if errors.Is(err, ErrAuth) || attempt >= len(c.retryDelays) {
+				c.mu.Lock()
+				c.terminal = err
+				c.notifyLocked()
+				c.mu.Unlock()
+				c.log(fmt.Sprintf("authentication stopped; reload required: %v", err))
+				return
+			}
+			c.log(fmt.Sprintf("control connection failed; retrying: %v", err))
+			if !c.wait(c.retryDelays[attempt]) {
+				return
+			}
+			attempt++
+			continue
+		}
+		c.mu.Lock()
+		if c.closed {
+			c.mu.Unlock()
+			g.close()
+			return
+		}
+		c.current = g
+		c.notifyLocked()
+		c.mu.Unlock()
+		c.log("authenticated")
+		heartbeatErr := c.heartbeat(g)
+		c.mu.Lock()
+		c.current = nil
+		c.notifyLocked()
+		c.mu.Unlock()
+		g.close()
+		if c.ctx.Err() != nil {
+			return
+		}
+		c.log(fmt.Sprintf("control connection lost; closing old data sessions: %v", heartbeatErr))
+		if !c.wait(c.retryDelays[0]) {
+			return
+		}
+		attempt = 1
+	}
+}
+func (c *Client) wait(d time.Duration) bool {
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-c.ctx.Done():
+		return false
+	case <-t.C:
+		return true
+	}
+}
+func (c *Client) Close() error {
+	c.mu.Lock()
+	if !c.closed {
+		c.closed = true
+		c.cancel()
+		c.notifyLocked()
+	}
+	g := c.current
+	c.mu.Unlock()
+	if g != nil {
+		g.close()
+	}
+	c.wg.Wait()
+	return nil
+}
+
+// Cancels a handshake by closing its socket; stop waits out the watcher so it
+// cannot close an established connection after the handshake has returned.
+func watchContext(ctx context.Context, s io.Closer) func() {
+	done, finished := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(finished)
+		select {
+		case <-ctx.Done():
+			s.Close()
+		case <-done:
+		}
+	}()
+	return func() { close(done); <-finished }
+}
+func (c *Client) login() (_ *generation, err error) {
+	phase := "control dial"
+	defer func() {
+		if err != nil {
+			err = fmt.Errorf("qyproxy %s: %w", phase, err)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(c.ctx, c.timeout)
+	defer cancel()
+	ip, err := c.resolveServer(ctx, c.opts.Server)
+	if err != nil {
+		return nil, err
+	}
+	ip = ip.Unmap()
+	if !ip.Is4() {
+		return nil, ErrIPv6
+	}
+	s, err := c.dialer.DialContext(ctx, "tcp", netip.AddrPortFrom(ip, c.opts.Port).String())
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err != nil {
+			s.Close()
+		}
+	}()
+	stop := watchContext(ctx, s)
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	if err = s.SetDeadline(deadline); err != nil {
+		return nil, err
+	}
+	phase = "configure write"
+	if err = writeFull(s, configure(c.opts)); err != nil {
+		return nil, err
+	}
+	g := &generation{control: s, ip: ip, sockets: make(map[io.Closer]struct{}), cache: make(map[string]dnsCache)}
+	configured, challenged := false, false
+	var challengeID byte
+	for count := 0; count < 12; count++ {
+		phase = "control response"
+		m, e := readMessage(s)
+		if e != nil {
+			return nil, e
+		}
+		switch {
+		case m.kind == 1 && m.code == 2:
+			phase = "configure ACK"
+			if configured || m.id != 0 {
+				return nil, ErrProtocol
+			}
+			g.config, err = parseConfigure(m.body)
+			if err != nil {
+				return nil, err
+			}
+			configured = true
+		case m.kind == 4 && m.code == 1:
+			phase = "CHAP challenge"
+			if !configured {
+				return nil, ErrProtocol
+			}
+			b, e := challengeResponse(c.opts, m)
+			if e != nil {
+				return nil, e
+			}
+			if e = writeFull(s, b); e != nil {
+				return nil, e
+			}
+			challengeID = m.id
+			challenged = true
+		case m.kind == 4 && (m.code == 3 || m.code == 5 || m.code == 7):
+			phase = "CHAP success"
+			if !configured || !challenged || m.id != challengeID {
+				return nil, ErrProtocol
+			}
+			g.token, err = parseSuccess(m)
+			if err != nil {
+				return nil, err
+			}
+			if err = ctx.Err(); err != nil {
+				return nil, err
+			}
+			if err = s.SetDeadline(time.Time{}); err != nil {
+				return nil, err
+			}
+			return g, nil
+		case m.kind == 4 && (m.code == 4 || m.code == 6):
+			return nil, ErrAuth
+		default:
+			return nil, ErrProtocol
+		}
+	}
+	return nil, ErrProtocol
+}
+func (c *Client) heartbeat(g *generation) error {
+	interval := g.config.interval
+	next := time.Now().Add(interval)
+	last := time.Now()
+	grace := interval * time.Duration(uint64(g.config.retries)+1)
+	for {
+		if c.ctx.Err() != nil {
+			return c.ctx.Err()
+		}
+		now := time.Now()
+		if now.Sub(last) >= grace {
+			return errors.New("qyproxy: heartbeat timeout")
+		}
+		if !now.Before(next) {
+			g.control.SetWriteDeadline(now.Add(c.timeout))
+			if err := writeFull(g.control, frame(1, 7, randomByte(), nil)); err != nil {
+				return err
+			}
+			next = now.Add(interval)
+		}
+		deadline := next
+		if last.Add(grace).Before(deadline) {
+			deadline = last.Add(grace)
+		}
+		g.control.SetReadDeadline(deadline)
+		// ReadFull may consume part of a frame before a timeout. A partial frame
+		// must terminate this generation instead of being parsed as a new header.
+		var first [1]byte
+		_, err := io.ReadFull(g.control, first[:])
+		if err != nil {
+			if e, ok := err.(net.Error); ok && e.Timeout() {
+				continue
+			}
+			return err
+		}
+		g.control.SetReadDeadline(time.Now().Add(c.timeout))
+		m, err := readMessage(io.MultiReader(&byteReader{b: first[:]}, g.control))
+		if err != nil {
+			return err
+		}
+		if m.kind != 1 || (m.code != 7 && m.code != 8) || len(m.body) != 0 {
+			return ErrProtocol
+		}
+		if m.code == 8 {
+			last = time.Now()
+		} else {
+			g.control.SetWriteDeadline(time.Now().Add(c.timeout))
+			if err = writeFull(g.control, frame(1, 8, randomByte(), nil)); err != nil {
+				return err
+			}
+		}
+	}
+}
+
+type byteReader struct{ b []byte }
+
+func (r *byteReader) Read(b []byte) (int, error) {
+	if len(r.b) == 0 {
+		return 0, io.EOF
+	}
+	n := copy(b, r.b)
+	r.b = r.b[n:]
+	return n, nil
+}
+func randomByte() byte { var b [1]byte; _, _ = rand.Read(b[:]); return b[0] }
+func (g *generation) track(s io.Closer) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		s.Close()
+		return ErrClosed
+	}
+	g.sockets[s] = struct{}{}
+	return nil
+}
+func (g *generation) untrack(s io.Closer) { g.mu.Lock(); delete(g.sockets, s); g.mu.Unlock() }
+func (g *generation) close() {
+	g.mu.Lock()
+	if g.closed {
+		g.mu.Unlock()
+		return
+	}
+	g.closed = true
+	sockets := make([]io.Closer, 0, len(g.sockets))
+	for s := range g.sockets {
+		sockets = append(sockets, s)
+	}
+	g.sockets = make(map[io.Closer]struct{})
+	g.cache = make(map[string]dnsCache)
+	g.mu.Unlock()
+	g.control.Close()
+	for _, s := range sockets {
+		s.Close()
+	}
+}
+func (g *generation) ports(udp bool) ([]uint16, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		return nil, ErrClosed
+	}
+	p, n := g.config.tcp, &g.tcpNext
+	if udp {
+		p, n = g.config.udp, &g.udpNext
+	}
+	start := *n % len(p)
+	*n = (*n + 1) % len(p)
+	out := append([]uint16{}, p[start:]...)
+	return append(out, p[:start]...), nil
+}
+func localSource(a net.Addr, g *generation) (netip.AddrPort, error) {
+	ap, err := netip.ParseAddrPort(a.String())
+	if err != nil {
+		return ap, errors.New("qyproxy: unsupported local socket address")
+	}
+	ip := ap.Addr().Unmap()
+	if ip.IsUnspecified() {
+		p, e := netip.ParseAddrPort(g.control.LocalAddr().String())
+		if e == nil {
+			ip = p.Addr().Unmap()
+		}
+		if !ip.Is4() {
+			ip = netip.IPv4Unspecified()
+		}
+	}
+	if !ip.Is4() {
+		return ap, ErrIPv6
+	}
+	return netip.AddrPortFrom(ip, ap.Port()), nil
+}
+
+func (c *Client) DialContext(ctx context.Context, target netip.AddrPort) (net.Conn, error) {
+	if !target.IsValid() || !target.Addr().Is4() || target.Port() == 0 {
+		return nil, ErrIPv6
+	}
+	ctx, cancel := context.WithTimeout(ctx, c.timeout)
+	defer cancel()
+	g, err := c.get(ctx)
+	if err != nil {
+		return nil, err
+	}
+	ports, err := g.ports(false)
+	if err != nil {
+		return nil, err
+	}
+	for _, p := range ports {
+		attempt, stop := context.WithTimeout(ctx, 4*time.Second)
+		s, e := c.openTCP(attempt, g, p, target)
+		stop()
+		if e == nil {
+			return s, nil
+		}
+		err = e
+		if errors.Is(e, ErrProtocol) || errors.Is(e, ErrSession) || errors.Is(e, ErrClosed) || ctx.Err() != nil {
+			break
+		}
+	}
+	return nil, err
+}
+func (c *Client) openTCP(ctx context.Context, g *generation, port uint16, target netip.AddrPort) (_ net.Conn, err error) {
+	s, err := c.dialer.DialContext(ctx, "tcp", netip.AddrPortFrom(g.ip, port).String())
+	if err != nil {
+		return nil, err
+	}
+	if err = g.track(s); err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err != nil {
+			g.untrack(s)
+			s.Close()
+		}
+	}()
+	stop := watchContext(ctx, s)
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	s.SetDeadline(deadline)
+	src, err := localSource(s.LocalAddr(), g)
+	if err != nil {
+		return nil, err
+	}
+	var mask [8]byte
+	if _, err = rand.Read(mask[:]); err != nil {
+		return nil, err
+	}
+	if err = writeFull(s, sessionInit(c.opts, g.token, mask, src, target)); err != nil {
+		return nil, err
+	}
+	var ack [14]byte
+	if _, err = io.ReadFull(s, ack[:]); err != nil {
+		return nil, err
+	}
+	if err = checkACK(ack[:]); err != nil {
+		return nil, err
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.SetDeadline(time.Time{})
+	return &streamConn{Conn: s, mask: mask, g: g}, nil
+}
+func (c *Client) ListenPacket(ctx context.Context) (net.PacketConn, error) {
+	ctx, cancel := context.WithTimeout(ctx, c.timeout)
+	defer cancel()
+	g, err := c.get(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return c.openPacket(ctx, g)
+}
+func (c *Client) openPacket(ctx context.Context, g *generation) (net.PacketConn, error) {
+	ports, err := g.ports(true)
+	if err != nil {
+		return nil, err
+	}
+	for _, p := range ports {
+		attempt, stop := context.WithTimeout(ctx, 4*time.Second)
+		s, e := c.openUDP(attempt, g, p)
+		stop()
+		if e == nil {
+			return s, nil
+		}
+		err = e
+		if errors.Is(e, ErrProtocol) || errors.Is(e, ErrSession) || errors.Is(e, ErrClosed) || ctx.Err() != nil {
+			break
+		}
+	}
+	return nil, err
+}
+func (c *Client) openUDP(ctx context.Context, g *generation, port uint16) (_ net.PacketConn, err error) {
+	remote := netip.AddrPortFrom(g.ip, port)
+	s, err := c.dialer.ListenPacket(ctx, "udp", "", remote)
+	if err != nil {
+		return nil, err
+	}
+	if err = g.track(s); err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err != nil {
+			g.untrack(s)
+			s.Close()
+		}
+	}()
+	stop := watchContext(ctx, s)
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	s.SetDeadline(deadline)
+	src, err := localSource(s.LocalAddr(), g)
+	if err != nil {
+		return nil, err
+	}
+	var mask [8]byte
+	if _, err = rand.Read(mask[:]); err != nil {
+		return nil, err
+	}
+	b := sessionInit(c.opts, g.token, mask, src, netip.AddrPort{})
+	raddr := net.UDPAddrFromAddrPort(remote)
+	if n, e := s.WriteTo(b, raddr); e != nil || n != len(b) {
+		err = e
+		if err == nil {
+			err = io.ErrShortWrite
+		}
+		return nil, err
+	}
+	buf := make([]byte, 2048)
+	for {
+		n, from, e := s.ReadFrom(buf)
+		if e != nil {
+			return nil, e
+		}
+		if !sameAddr(from, remote) {
+			continue
+		}
+		if err = checkACK(buf[:n]); err != nil {
+			return nil, err
+		}
+		break
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.SetDeadline(time.Time{})
+	return &packetConn{PacketConn: s, g: g, opts: c.opts, remote: remote, mask: mask, pending: make(map[uint16]dnsPending)}, nil
+}
+func sameAddr(a net.Addr, b netip.AddrPort) bool {
+	p, e := netip.ParseAddrPort(a.String())
+	return e == nil && netip.AddrPortFrom(p.Addr().Unmap(), p.Port()) == b
+}
diff --git a/proxy/qyproxy/transport/client_test.go b/proxy/qyproxy/transport/client_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/qyproxy/transport/client_test.go
@@ -0,0 +1,508 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from ztyawc/mihomo-cn2 at 0d09a3da4fc9b9c400a33bbd6b0e04c6543d362a.
+package qyproxy
+
+import (
+	"bytes"
+	"context"
+	"crypto/md5"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+)
+
+type testDialer struct{}
+
+func (testDialer) DialContext(ctx context.Context, n, a string) (net.Conn, error) {
+	return (&net.Dialer{}).DialContext(ctx, n, a)
+}
+func (testDialer) ListenPacket(ctx context.Context, n, a string, _ netip.AddrPort) (net.PacketConn, error) {
+	return (&net.ListenConfig{}).ListenPacket(ctx, "udp4", "127.0.0.1:0")
+}
+
+// This fixture is a synthetic node: it verifies credentials independently,
+// negotiates random ports, changes tokens at each login and runs real sockets.
+type testNode struct {
+	t             *testing.T
+	o             Options
+	control, data net.Listener
+	udp           *net.UDPConn
+	code          byte
+	reject        atomic.Bool
+	logins, acks  atomic.Int32
+	mu            sync.Mutex
+	connections   map[net.Conn]bool
+	controls      map[net.Conn]bool
+	closed        bool
+	wg            sync.WaitGroup
+}
+
+func newTestNode(t *testing.T, role string, code byte) *testNode {
+	a, e := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, e)
+	b, e := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, e)
+	u, e := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, e)
+	o := testOptions()
+	o.Role = role
+	o.Port = uint16(a.Addr().(*net.TCPAddr).Port)
+	require.NoError(t, o.normalize())
+	n := &testNode{t: t, o: o, control: a, data: b, udp: u, code: code, connections: make(map[net.Conn]bool), controls: make(map[net.Conn]bool)}
+	n.wg.Add(3)
+	go n.accept(a, true)
+	go n.accept(b, false)
+	go n.serveUDP()
+	t.Cleanup(func() {
+		n.mu.Lock()
+		n.closed = true
+		a.Close()
+		b.Close()
+		u.Close()
+		for c := range n.connections {
+			c.Close()
+		}
+		n.mu.Unlock()
+		n.wg.Wait()
+	})
+	return n
+}
+func (n *testNode) accept(l net.Listener, control bool) {
+	defer n.wg.Done()
+	for {
+		s, e := l.Accept()
+		if e != nil {
+			return
+		}
+		n.mu.Lock()
+		if n.closed {
+			n.mu.Unlock()
+			s.Close()
+			return
+		}
+		n.connections[s] = true
+		if control {
+			n.controls[s] = true
+		}
+		n.wg.Add(1)
+		n.mu.Unlock()
+		go func() {
+			defer n.wg.Done()
+			defer s.Close()
+			defer func() { n.mu.Lock(); delete(n.connections, s); delete(n.controls, s); n.mu.Unlock() }()
+			s.SetDeadline(time.Now().Add(15 * time.Second))
+			if control {
+				n.serveControl(s)
+			} else {
+				n.serveTCP(s)
+			}
+		}()
+	}
+}
+func (n *testNode) serveControl(s net.Conn) {
+	magic := make([]byte, 4)
+	if _, e := io.ReadFull(s, magic); e != nil {
+		return
+	}
+	if !bytes.Equal(magic, controlMagic) {
+		n.t.Error("wrong control magic")
+		return
+	}
+	m, e := readMessage(s)
+	if e != nil {
+		return
+	}
+	require.Equal(n.t, configure(n.o)[4:], frame(m.kind, m.code, m.id, m.body))
+	ports := append(be16(uint16(n.data.Addr().(*net.TCPAddr).Port)), be16(uint16(n.udp.LocalAddr().(*net.UDPAddr).Port))...)
+	b := option(3, []byte{4, 5}, true)
+	b = append(b, option(4, ports, true)...)
+	b = append(b, option(6, []byte{0, 5, 0, 1}, true)...)
+	b = append(b, option(9, []byte{9, '1', '9', '2', '.', '0', '.', '2', '.', '9'}, true)...)
+	if n.o.Role == Primary {
+		b = append(b, option(18, be16(5353), true)...)
+	}
+	if writeFull(s, frame(1, 2, 0, b)) != nil {
+		return
+	}
+	challenge := []byte("synthetic-challenge")
+	writeFull(s, frame(4, 1, 17, append([]byte{byte(len(challenge))}, challenge...)))
+	m, e = readMessage(s)
+	if e != nil {
+		return
+	}
+	digest := md5.Sum(append(append([]byte{17}, n.o.Password...), challenge...))
+	if m.kind != 4 || m.code != 2 || m.id != 17 || len(m.body) < 17 || !bytes.Equal(digest[:], m.body[1:17]) || string(m.body[17:]) != n.o.wireUsername() {
+		n.t.Error("invalid client CHAP")
+		return
+	}
+	count := n.logins.Add(1)
+	if n.reject.Load() {
+		writeFull(s, frame(4, 4, 17, nil))
+		return
+	}
+	token := bytes.Repeat([]byte{byte(count)}, 16)
+	body := token
+	if n.code == 5 {
+		body = append([]byte{0, 0, 16}, token...)
+	}
+	if n.code == 7 {
+		body = append([]byte{0, 0, 18, 2, 16}, token...)
+	}
+	writeFull(s, frame(4, n.code, 17, body))
+	writeFull(s, frame(1, 7, 50, nil))
+	for {
+		m, e = readMessage(s)
+		if e != nil {
+			return
+		}
+		if m.kind != 1 {
+			n.t.Error("invalid heartbeat")
+			return
+		}
+		if m.code == 7 {
+			writeFull(s, frame(1, 8, 99, nil))
+			n.acks.Add(1)
+		} else if m.code == 8 {
+			n.acks.Add(1)
+		}
+	}
+}
+func (n *testNode) session(b []byte) ([8]byte, error) {
+	var mask [8]byte
+	if len(b) < 6 || !bytes.Equal(b[:4], dataMagic) {
+		return mask, ErrProtocol
+	}
+	length := int(binary.BigEndian.Uint16(b[4:]) & 0x7fff)
+	if len(b) != length+6 {
+		return mask, ErrProtocol
+	}
+	b = b[6:]
+	var token []byte
+	var area string
+	for len(b) > 0 {
+		if len(b) < 2 || len(b) < 2+int(b[1]) {
+			return mask, ErrProtocol
+		}
+		v := b[2 : 2+int(b[1])]
+		switch b[0] {
+		case 1:
+			token = v
+		case 10:
+			area = string(v)
+		case 8, 17:
+			if len(v) != 8 {
+				return mask, ErrProtocol
+			}
+			copy(mask[:], v)
+		}
+		b = b[2+int(b[1]):]
+	}
+	if !bytes.Equal(token, bytes.Repeat([]byte{byte(n.logins.Load())}, 16)) || area != n.o.dataArea() {
+		return mask, ErrAuth
+	}
+	return mask, nil
+}
+func (n *testNode) serveTCP(s net.Conn) {
+	h := make([]byte, 6)
+	if _, e := io.ReadFull(s, h); e != nil {
+		return
+	}
+	b := make([]byte, int(binary.BigEndian.Uint16(h[4:])&0x7fff))
+	if len(b) > 2048 {
+		return
+	}
+	if _, e := io.ReadFull(s, b); e != nil {
+		return
+	}
+	mask, e := n.session(append(h, b...))
+	if e != nil {
+		return
+	}
+	ack := append([]byte{5, 0}, make([]byte, 12)...)
+	banner := []byte("server-first")
+	xor(banner, mask, 0)
+	writeFull(s, append(ack, banner...))
+	var pos uint64
+	buf := make([]byte, 123)
+	var plain []byte
+	for {
+		nr, e := s.Read(buf)
+		if nr > 0 {
+			xor(buf[:nr], mask, pos)
+			pos += uint64(nr)
+			plain = append(plain, buf[:nr]...)
+		}
+		if e != nil {
+			if e != io.EOF {
+				return
+			}
+			break
+		}
+	}
+	// After client's FIN, the server can still send a long reply.
+	xor(plain, mask, uint64(len(banner)))
+	writeFull(s, plain)
+}
+func (n *testNode) serveUDP() {
+	defer n.wg.Done()
+	sessions := map[netip.AddrPort][8]byte{}
+	buf := make([]byte, 65535)
+	for {
+		nr, from, e := n.udp.ReadFromUDPAddrPort(buf)
+		if e != nil {
+			return
+		}
+		b := append([]byte{}, buf[:nr]...)
+		if bytes.HasPrefix(b, dataMagic) {
+			mask, e := n.session(b)
+			if e != nil {
+				continue
+			}
+			sessions[from] = mask
+			n.udp.WriteToUDPAddrPort(append([]byte{5, 0}, make([]byte, 12)...), from)
+			continue
+		}
+		mask, ok := sessions[from]
+		if !ok {
+			continue
+		}
+		target, p, e := parseUDP(b, mask)
+		if e != nil {
+			continue
+		}
+		if target.Port() == 53 || target.Port() == 5353 {
+			if n.o.Role == Primary {
+				prefix := append([]byte{1, byte(len(n.o.GameArea))}, n.o.GameArea...)
+				if !bytes.HasPrefix(p, prefix) {
+					n.t.Error("missing primary DNS prefix")
+					continue
+				}
+				p = p[len(prefix):]
+			}
+			var m dns.Msg
+			if m.Unpack(p) != nil {
+				continue
+			}
+			reply := new(dns.Msg)
+			reply.SetReply(&m)
+			reply.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: m.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 30}, A: net.IPv4(192, 0, 2, 1)}}
+			p, _ = reply.Pack()
+		}
+		n.udp.WriteToUDPAddrPort(udpFrame(target, p, mask), from)
+	}
+}
+func (n *testNode) dropControl() {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	for s := range n.controls {
+		s.Close()
+	}
+}
+func (n *testNode) client(t *testing.T) *Client {
+	c, e := New(n.o, testDialer{}, func(context.Context, string) (netip.Addr, error) { return netip.MustParseAddr("127.0.0.1"), nil }, nil)
+	require.NoError(t, e)
+	c.retryDelays = []time.Duration{10 * time.Millisecond, 20 * time.Millisecond, 30 * time.Millisecond}
+	t.Cleanup(func() { c.Close() })
+	return c
+}
+
+func TestClientRolesAndData(t *testing.T) {
+	for _, test := range []struct {
+		role string
+		code byte
+	}{{Primary, 7}, {CN2, 5}, {CN2Download, 5}, {Primary, 3}} {
+		t.Run(fmt.Sprintf("%s_%d", test.role, test.code), func(t *testing.T) {
+			n := newTestNode(t, test.role, test.code)
+			c := n.client(t)
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			ip, e := c.Resolve(ctx, "example.com")
+			require.NoError(t, e)
+			require.Equal(t, netip.MustParseAddr("192.0.2.1"), ip)
+			s, e := c.DialContext(ctx, netip.AddrPortFrom(ip, 80))
+			require.NoError(t, e)
+			defer s.Close()
+			s.SetDeadline(time.Now().Add(5 * time.Second))
+			banner := make([]byte, 12)
+			_, e = io.ReadFull(s, banner)
+			require.NoError(t, e)
+			require.Equal(t, "server-first", string(banner))
+			original := bytes.Repeat([]byte("data-over-copy-path"), 10000)
+			payload := append([]byte{}, original...)
+			_, e = io.Copy(s, bytes.NewReader(payload))
+			require.NoError(t, e)
+			require.Equal(t, original, payload, "must not modify caller buffers")
+			require.NoError(t, s.(interface{ CloseWrite() error }).CloseWrite())
+			reply, e := io.ReadAll(s)
+			require.NoError(t, e)
+			require.Equal(t, payload, reply)
+			pc, e := c.ListenPacket(ctx)
+			require.NoError(t, e)
+			defer pc.Close()
+			pc.SetDeadline(time.Now().Add(5 * time.Second))
+			target := net.UDPAddrFromAddrPort(netip.MustParseAddrPort("192.0.2.5:3478"))
+			for _, p := range [][]byte{[]byte("ordinary UDP"), []byte("second packet")} {
+				_, e = pc.WriteTo(p, target)
+				require.NoError(t, e)
+				b := make([]byte, 100)
+				size, from, e := pc.ReadFrom(b)
+				require.NoError(t, e)
+				require.Equal(t, target.String(), from.String())
+				require.Equal(t, p, b[:size])
+			}
+			_, e = pc.WriteTo(make([]byte, 1401), target)
+			require.ErrorIs(t, e, ErrOversize)
+			require.Equal(t, int32(1), n.logins.Load())
+		})
+	}
+}
+func TestConcurrentLoginAndRecovery(t *testing.T) {
+	n := newTestNode(t, CN2, 5)
+	c := n.client(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			s, e := c.ListenPacket(ctx)
+			if e != nil {
+				t.Error(e)
+				return
+			}
+			s.Close()
+		}()
+	}
+	wg.Wait()
+	require.Equal(t, int32(1), n.logins.Load())
+	s, e := c.DialContext(ctx, netip.MustParseAddrPort("192.0.2.1:80"))
+	require.NoError(t, e)
+	defer s.Close()
+	banner := make([]byte, 12)
+	_, e = io.ReadFull(s, banner)
+	require.NoError(t, e)
+	n.dropControl()
+	require.Eventually(t, func() bool { return n.logins.Load() == 2 }, time.Second, 5*time.Millisecond)
+	s.SetReadDeadline(time.Now().Add(time.Second))
+	_, e = s.Read(make([]byte, 1))
+	require.Error(t, e)
+	ip, e := c.Resolve(ctx, "example.com")
+	require.NoError(t, e)
+	require.True(t, ip.Is4())
+	require.NoError(t, c.Close())
+	_, e = c.ListenPacket(ctx)
+	require.ErrorIs(t, e, ErrClosed)
+}
+func TestRejectionAndCancellation(t *testing.T) {
+	n := newTestNode(t, Primary, 7)
+	n.reject.Store(true)
+	c := n.client(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	_, e := c.ListenPacket(ctx)
+	require.ErrorIs(t, e, ErrAuth)
+	_, e = c.ListenPacket(ctx)
+	require.ErrorIs(t, e, ErrAuth)
+	require.Equal(t, int32(1), n.logins.Load())
+	dead, stop := context.WithCancel(context.Background())
+	stop()
+	_, e = c.ListenPacket(dead)
+	require.ErrorIs(t, e, context.Canceled)
+}
+func TestDNSRepeatedIDs(t *testing.T) {
+	n := newTestNode(t, Primary, 7)
+	c := n.client(t)
+	pc, e := c.ListenPacket(context.Background())
+	require.NoError(t, e)
+	defer pc.Close()
+	pc.SetDeadline(time.Now().Add(5 * time.Second))
+	for i := 0; i < 20; i++ {
+		m := new(dns.Msg)
+		m.SetQuestion(fmt.Sprintf("n%d.example.", i), dns.TypeA)
+		m.Id = 42
+		b, e := m.Pack()
+		require.NoError(t, e)
+		_, e = pc.WriteTo(b, net.UDPAddrFromAddrPort(netip.AddrPortFrom(netip.MustParseAddr("8.8.8.8"), 53)))
+		require.NoError(t, e)
+	}
+	names := map[string]bool{}
+	for i := 0; i < 20; i++ {
+		b := make([]byte, 1500)
+		size, from, e := pc.ReadFrom(b)
+		require.NoError(t, e)
+		require.Equal(t, "8.8.8.8:53", from.String())
+		var m dns.Msg
+		require.NoError(t, m.Unpack(b[:size]))
+		require.Equal(t, uint16(42), m.Id)
+		names[m.Question[0].Name] = true
+	}
+	require.Len(t, names, 20)
+}
+
+func TestHeartbeatTimeoutAndPartialFrame(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		t.Run(fmt.Sprint(partial), func(t *testing.T) {
+			left, right := net.Pipe()
+			defer left.Close()
+			defer right.Close()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			c := &Client{ctx: ctx, timeout: 50 * time.Millisecond}
+			g := &generation{control: left, config: negotiated{interval: 20 * time.Millisecond, retries: 1}}
+			done := make(chan error, 1)
+			go func() { done <- c.heartbeat(g) }()
+			if partial {
+				// A truncated header must fail instead of desynchronizing the stream.
+				_, e := right.Write([]byte{1, 8})
+				require.NoError(t, e)
+			} else {
+				go io.Copy(io.Discard, right) // consume heartbeat requests; send no ACK
+			}
+			select {
+			case e := <-done:
+				require.Error(t, e)
+			case <-time.After(time.Second):
+				t.Fatal("heartbeat did not expire")
+			}
+		})
+	}
+}
+
+type stalledDialer struct {
+	testDialer
+	peer chan net.Conn
+}
+
+func (d stalledDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	a, b := net.Pipe()
+	d.peer <- b
+	return a, nil
+}
+func TestCloseCancelsPendingLogin(t *testing.T) {
+	d := stalledDialer{peer: make(chan net.Conn, 1)}
+	o := testOptions()
+	c, e := New(o, d, func(context.Context, string) (netip.Addr, error) { return netip.MustParseAddr("127.0.0.1"), nil }, nil)
+	require.NoError(t, e)
+	result := make(chan error, 1)
+	go func() { _, e := c.ListenPacket(context.Background()); result <- e }()
+	peer := <-d.peer
+	defer peer.Close()
+	done := make(chan struct{})
+	go func() { c.Close(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Close blocked during handshake")
+	}
+	require.ErrorIs(t, <-result, ErrClosed)
+}
diff --git a/proxy/qyproxy/transport/conn.go b/proxy/qyproxy/transport/conn.go
new file mode 100644
--- /dev/null
+++ b/proxy/qyproxy/transport/conn.go
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from ztyawc/mihomo-cn2 at 0d09a3da4fc9b9c400a33bbd6b0e04c6543d362a.
+package qyproxy
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+type streamConn struct {
+	net.Conn
+	g        *generation
+	mask     [8]byte
+	rmu, wmu sync.Mutex
+	rx, tx   uint64
+	once     sync.Once
+}
+
+// Expose half-close traversal, but never permit copy/splice to bypass the codec.
+func (c *streamConn) Upstream() any           { return c.Conn }
+func (c *streamConn) ReaderReplaceable() bool { return false }
+func (c *streamConn) WriterReplaceable() bool { return false }
+func (c *streamConn) Read(b []byte) (int, error) {
+	c.rmu.Lock()
+	defer c.rmu.Unlock()
+	n, e := c.Conn.Read(b)
+	xor(b[:n], c.mask, c.rx)
+	c.rx += uint64(n)
+	return n, e
+}
+func (c *streamConn) Write(b []byte) (int, error) {
+	c.wmu.Lock()
+	defer c.wmu.Unlock()
+	total := 0
+	size := len(b)
+	if size > 32768 {
+		size = 32768
+	}
+	scratch := make([]byte, size)
+	for len(b) > 0 {
+		next := len(b)
+		if next > len(scratch) {
+			next = len(scratch)
+		}
+		copy(scratch, b[:next])
+		xor(scratch[:next], c.mask, c.tx)
+		written := 0
+		for written < next {
+			n, err := c.Conn.Write(scratch[written:next])
+			if n < 0 || n > next-written {
+				return total, io.ErrShortWrite
+			}
+			written += n
+			total += n
+			c.tx += uint64(n)
+			if err != nil {
+				return total, err
+			}
+			if n == 0 {
+				return total, io.ErrShortWrite
+			}
+		}
+		b = b[next:]
+	}
+	return total, nil
+}
+func (c *streamConn) CloseWrite() error {
+	if s, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return s.CloseWrite()
+	}
+	return c.Close()
+}
+func (c *streamConn) CloseRead() error {
+	if s, ok := c.Conn.(interface{ CloseRead() error }); ok {
+		return s.CloseRead()
+	}
+	return c.Close()
+}
+func (c *streamConn) Close() error {
+	var err error
+	c.once.Do(func() { c.g.untrack(c.Conn); err = c.Conn.Close() })
+	return err
+}
+
+type dnsPending struct {
+	target   netip.AddrPort
+	id       uint16
+	expires  time.Time
+	question []dns.Question
+}
+type packetConn struct {
+	net.PacketConn
+	g            *generation
+	opts         Options
+	remote       netip.AddrPort
+	mask         [8]byte
+	rmu, wmu, mu sync.Mutex
+	pending      map[uint16]dnsPending
+	nextID       uint16
+	once         sync.Once
+}
+
+func (c *packetConn) Upstream() any           { return c.PacketConn }
+func (c *packetConn) ReaderReplaceable() bool { return false }
+func (c *packetConn) WriterReplaceable() bool { return false }
+func (c *packetConn) dnsTarget() (netip.AddrPort, error) {
+	if c.opts.Role != Primary {
+		return netip.MustParseAddrPort("1.1.1.1:53"), nil
+	}
+	if !c.g.config.dns.IsValid() {
+		return netip.AddrPort{}, errors.New("qyproxy: node did not supply DNS")
+	}
+	return c.g.config.dns, nil
+}
+func (c *packetConn) WriteTo(b []byte, a net.Addr) (int, error) {
+	c.wmu.Lock()
+	defer c.wmu.Unlock()
+	target, err := netip.ParseAddrPort(a.String())
+	if err != nil || !target.Addr().Unmap().Is4() || target.Port() == 0 {
+		return 0, ErrIPv6
+	}
+	target = netip.AddrPortFrom(target.Addr().Unmap(), target.Port())
+	payload := b
+	var id uint16
+	isDNS := target.Port() == 53
+	if isDNS {
+		var m dns.Msg
+		if e := m.Unpack(b); e != nil || m.Response || len(m.Question) == 0 {
+			return 0, ErrProtocol
+		}
+		dest, e := c.dnsTarget()
+		if e != nil {
+			return 0, e
+		}
+		c.mu.Lock()
+		now := time.Now()
+		for key, v := range c.pending {
+			if now.After(v.expires) {
+				delete(c.pending, key)
+			}
+		}
+		if len(c.pending) >= 1024 {
+			c.mu.Unlock()
+			return 0, errors.New("qyproxy: too many outstanding DNS requests")
+		}
+		for {
+			c.nextID++
+			if _, used := c.pending[c.nextID]; !used {
+				break
+			}
+		}
+		id = c.nextID
+		c.pending[id] = dnsPending{target, m.Id, now.Add(15 * time.Second), m.Question}
+		c.mu.Unlock()
+		defer func() {
+			if err != nil {
+				c.mu.Lock()
+				delete(c.pending, id)
+				c.mu.Unlock()
+			}
+		}()
+		prefix := []byte{}
+		if c.opts.Role == Primary {
+			prefix = append([]byte{1, byte(len(c.opts.GameArea))}, c.opts.GameArea...)
+		}
+		payload = make([]byte, len(prefix)+len(b))
+		copy(payload, prefix)
+		copy(payload[len(prefix):], b)
+		binary.BigEndian.PutUint16(payload[len(prefix):], id)
+		target = dest
+	}
+	if len(payload)+10 > c.opts.mtu() {
+		err = ErrOversize
+		return 0, err
+	}
+	wire := udpFrame(target, payload, c.mask)
+	n, e := c.PacketConn.WriteTo(wire, net.UDPAddrFromAddrPort(c.remote))
+	err = e
+	if err == nil && n != len(wire) {
+		err = io.ErrShortWrite
+	}
+	if err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+func (c *packetConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	c.rmu.Lock()
+	defer c.rmu.Unlock()
+	wire := make([]byte, 65535)
+	for {
+		n, from, err := c.PacketConn.ReadFrom(wire)
+		if err != nil {
+			return 0, nil, err
+		}
+		if !sameAddr(from, c.remote) {
+			continue
+		}
+		if n == 14 && wire[0] == 5 && wire[1] == 3 {
+			c.Close()
+			return 0, nil, errors.New("qyproxy: UDP session released")
+		}
+		source, payload, e := parseUDP(wire[:n], c.mask)
+		if e != nil {
+			continue
+		}
+		dest, e := c.dnsTarget()
+		if e == nil && source == dest {
+			var m dns.Msg
+			if e = m.Unpack(payload); e != nil || !m.Response {
+				continue
+			}
+			c.mu.Lock()
+			p, ok := c.pending[m.Id]
+			valid := ok && time.Now().Before(p.expires) && sameQuestions(m.Question, p.question)
+			if valid {
+				delete(c.pending, m.Id)
+			}
+			c.mu.Unlock()
+			if !valid {
+				continue
+			}
+			binary.BigEndian.PutUint16(payload, p.id)
+			source = p.target
+		}
+		copied := copy(b, payload)
+		if copied < len(payload) {
+			return copied, net.UDPAddrFromAddrPort(source), io.ErrShortBuffer
+		}
+		return copied, net.UDPAddrFromAddrPort(source), nil
+	}
+}
+func (c *packetConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		c.g.untrack(c.PacketConn)
+		err = c.PacketConn.Close()
+		c.mu.Lock()
+		clearPending := make(map[uint16]dnsPending)
+		c.pending = clearPending
+		c.mu.Unlock()
+	})
+	return err
+}
diff --git a/proxy/qyproxy/transport/dns.go b/proxy/qyproxy/transport/dns.go
new file mode 100644
--- /dev/null
+++ b/proxy/qyproxy/transport/dns.go
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from ztyawc/mihomo-cn2 at 0d09a3da4fc9b9c400a33bbd6b0e04c6543d362a.
+package qyproxy
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+type dnsCache struct {
+	ip      netip.Addr
+	expires time.Time
+}
+
+func sameQuestions(a, b []dns.Question) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !strings.EqualFold(a[i].Name, b[i].Name) || a[i].Qtype != b[i].Qtype || a[i].Qclass != b[i].Qclass {
+			return false
+		}
+	}
+	return true
+}
+
+// Resolve queries DNS through this authenticated generation, never the local
+// resolver. Explicit addresses pass through without generating a DNS query.
+func (c *Client) Resolve(ctx context.Context, host string) (netip.Addr, error) {
+	if ip, err := netip.ParseAddr(host); err == nil {
+		ip = ip.Unmap()
+		if !ip.Is4() {
+			return netip.Addr{}, ErrIPv6
+		}
+		return ip, nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, c.timeout)
+	defer cancel()
+	g, err := c.get(ctx)
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	key := strings.ToLower(dns.Fqdn(host))
+	g.mu.Lock()
+	cached, found := g.cache[key]
+	g.mu.Unlock()
+	if found && time.Now().Before(cached.expires) {
+		return cached.ip, nil
+	}
+	m := new(dns.Msg)
+	m.SetQuestion(key, dns.TypeA)
+	m.Id = uint16(randomByte())<<8 | uint16(randomByte())
+	b, err := m.Pack()
+	if err != nil {
+		return netip.Addr{}, errors.New("qyproxy: invalid DNS name")
+	}
+	s, err := c.openPacket(ctx, g)
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	defer s.Close()
+	stop := watchContext(ctx, s)
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	s.SetDeadline(deadline)
+	target := netip.MustParseAddrPort("1.1.1.1:53")
+	if _, err = s.WriteTo(b, net.UDPAddrFromAddrPort(target)); err != nil {
+		return netip.Addr{}, err
+	}
+	buf := make([]byte, 4096)
+	n, from, err := s.ReadFrom(buf)
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	if !sameAddr(from, target) {
+		return netip.Addr{}, ErrProtocol
+	}
+	var reply dns.Msg
+	if err = reply.Unpack(buf[:n]); err != nil || reply.Id != m.Id || !reply.Response || reply.Truncated || !sameQuestions(reply.Question, m.Question) {
+		return netip.Addr{}, ErrProtocol
+	}
+	if reply.Rcode != dns.RcodeSuccess {
+		return netip.Addr{}, errors.New("qyproxy: remote DNS query failed")
+	}
+	// Only accept A records belonging to the queried name or its CNAME chain.
+	names := map[string]bool{key: true}
+	ttl := uint32(30)
+	for i := 0; i < len(reply.Answer); i++ {
+		for _, rr := range reply.Answer {
+			if v, ok := rr.(*dns.CNAME); ok && names[strings.ToLower(v.Hdr.Name)] {
+				names[strings.ToLower(v.Target)] = true
+				if v.Hdr.Ttl < ttl {
+					ttl = v.Hdr.Ttl
+				}
+			}
+		}
+	}
+	for _, rr := range reply.Answer {
+		if a, ok := rr.(*dns.A); ok && names[strings.ToLower(a.Hdr.Name)] {
+			ip, ok := netip.AddrFromSlice(a.A)
+			if !ok || !ip.Unmap().Is4() {
+				continue
+			}
+			ip = ip.Unmap()
+			if a.Hdr.Ttl < ttl {
+				ttl = a.Hdr.Ttl
+			}
+			g.mu.Lock()
+			if g.closed {
+				g.mu.Unlock()
+				return netip.Addr{}, ErrClosed
+			}
+			if len(g.cache) >= 256 {
+				g.cache = make(map[string]dnsCache)
+			}
+			if ttl > 0 {
+				g.cache[key] = dnsCache{ip, time.Now().Add(time.Duration(ttl) * time.Second)}
+			}
+			g.mu.Unlock()
+			return ip, nil
+		}
+	}
+	return netip.Addr{}, errors.New("qyproxy: remote DNS returned no IPv4 address")
+}
diff --git a/proxy/qyproxy/transport/protocol.go b/proxy/qyproxy/transport/protocol.go
new file mode 100644
--- /dev/null
+++ b/proxy/qyproxy/transport/protocol.go
@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Adapted from ztyawc/mihomo-cn2 at 0d09a3da4fc9b9c400a33bbd6b0e04c6543d362a.
+// Package qyproxy implements the observed IPv4 QyProxy game transport.
+// It does not implement SOCKS authentication, QyVpn, or Hop.
+package qyproxy
+
+import (
+	"crypto/md5"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net/netip"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	Primary     = "primary"
+	CN2         = "cn2"
+	CN2Download = "cn2_download"
+)
+
+var (
+	controlMagic = []byte{0xae, 0xdb, 0xcb, 0x43}
+	dataMagic    = []byte{0xae, 0xdb, 0xcb, 0xec}
+	ErrAuth      = errors.New("qyproxy: authentication rejected; refresh credentials and reload")
+	ErrClosed    = errors.New("qyproxy: closed")
+	ErrProtocol  = errors.New("qyproxy: malformed or unsupported protocol message")
+	ErrIPv6      = errors.New("qyproxy: only IPv4 destinations are supported")
+	ErrOversize  = errors.New("qyproxy: UDP packet requires unsupported fragmentation")
+	ErrSession   = errors.New("qyproxy: data session rejected or released")
+)
+
+// Options contains node credentials, never APP/API tokens. Port is the actual
+// control port, not the generic port in a native APP profile.
+type Options struct {
+	Server     string
+	Port       uint16
+	Role       string
+	Username   string
+	Password   string
+	SN         string
+	GameID     uint32
+	ServerID   uint32
+	ClientType uint32
+	GameArea   string
+	Zone       string
+	Product    string
+	Version    string
+}
+
+func (o *Options) normalize() error {
+	if o.Role == "" {
+		o.Role = Primary
+	}
+	if o.ClientType == 0 {
+		o.ClientType = 20
+	}
+	if o.GameArea == "" {
+		o.GameArea = "default"
+	}
+	if o.Zone == "" {
+		o.Zone = o.GameArea
+	}
+	if o.Product == "" {
+		o.Product = "hy-android"
+	}
+	if o.Version == "" {
+		o.Version = "1.0.0"
+	}
+	if o.Role != Primary && o.Role != CN2 && o.Role != CN2Download {
+		return errors.New("qyproxy: role must be primary, cn2 or cn2_download")
+	}
+	if o.Server == "" || o.Port == 0 || o.GameID == 0 || o.ServerID == 0 {
+		return errors.New("qyproxy: server, port, game-id and server-id are required")
+	}
+	for _, s := range []string{o.Username, o.Password, o.SN, o.GameArea, o.Zone, o.Product, o.Version} {
+		if len(s) == 0 || len(s) > 128 || strings.ContainsRune(s, 0) {
+			return errors.New("qyproxy: invalid credential or protocol text length")
+		}
+	}
+	if strings.Contains(o.Username, "&") || strings.Contains(o.SN, "&") || len(o.wireUsername()) > 254 {
+		return errors.New("qyproxy: invalid composed username")
+	}
+	return nil
+}
+
+// Validate checks the public configuration without mutating the caller's options.
+func (o Options) Validate() error { return o.normalize() }
+
+func (o Options) wireUsername() string {
+	return o.Username + "&" + strconv.FormatUint(uint64(o.ClientType), 10) + "&" + strconv.FormatUint(uint64(o.GameID), 10) + "&" + o.SN
+}
+func (o Options) dataArea() string {
+	if o.Role == Primary {
+		return o.GameArea
+	}
+	return o.Role
+}
+func (o Options) mtu() int {
+	if o.Role == Primary {
+		return 1400
+	}
+	return 1200
+}
+
+type message struct {
+	kind, code, id byte
+	body           []byte
+}
+
+func frame(kind, code, id byte, body []byte) []byte {
+	b := make([]byte, 5+len(body))
+	b[0], b[1], b[2] = kind, code, id
+	binary.BigEndian.PutUint16(b[3:], uint16(4+len(body)))
+	copy(b[5:], body)
+	return b
+}
+func readMessage(r io.Reader) (message, error) {
+	var h [5]byte
+	if _, err := io.ReadFull(r, h[:]); err != nil {
+		return message{}, err
+	}
+	n := int(binary.BigEndian.Uint16(h[3:]))
+	if n < 4 || n > 2047 {
+		return message{}, ErrProtocol
+	}
+	m := message{h[0], h[1], h[2], make([]byte, n-4)}
+	_, err := io.ReadFull(r, m.body)
+	return m, err
+}
+func writeFull(w io.Writer, b []byte) error {
+	for len(b) > 0 {
+		n, err := w.Write(b)
+		if n < 0 || n > len(b) {
+			return io.ErrShortWrite
+		}
+		b = b[n:]
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+func option(kind byte, value []byte, inclusive bool) []byte {
+	n := len(value)
+	if inclusive {
+		n += 2
+	}
+	return append([]byte{kind, byte(n)}, value...)
+}
+func parseOptions(b []byte, inclusive bool) (map[byte][]byte, error) {
+	out := make(map[byte][]byte)
+	for len(b) > 0 {
+		if len(b) < 2 {
+			return nil, ErrProtocol
+		}
+		n := int(b[1])
+		if !inclusive {
+			n += 2
+		}
+		if n < 2 || n > len(b) {
+			return nil, ErrProtocol
+		}
+		if _, ok := out[b[0]]; ok {
+			return nil, ErrProtocol
+		}
+		out[b[0]] = b[2:n]
+		b = b[n:]
+	}
+	return out, nil
+}
+func be16(n uint16) []byte { b := make([]byte, 2); binary.BigEndian.PutUint16(b, n); return b }
+func configure(o Options) []byte {
+	zone, area := o.Zone, o.GameArea
+	if o.Role != Primary {
+		zone, area = o.Role, o.Role
+	}
+	b := option(7, be16(1200), true)
+	b = append(b, option(2, []byte{1, 2, 0x21}, true)...)
+	id := make([]byte, 4)
+	binary.BigEndian.PutUint32(id, o.ServerID)
+	b = append(b, option(15, id, true)...)
+	for _, v := range []struct {
+		k byte
+		s string
+	}{{8, area}, {11, o.Product}, {12, o.Version}, {17, "vpn"}, {13, o.GameArea}, {14, zone}} {
+		b = append(b, option(v.k, append([]byte{byte(len(v.s))}, v.s...), true)...)
+	}
+	b = append(b, option(3, []byte{4, 5}, true)...)
+	return append(append([]byte{}, controlMagic...), frame(1, 1, 0, b)...)
+}
+func challengeResponse(o Options, m message) ([]byte, error) {
+	if len(m.body) == 0 || m.body[0] == 0 || int(m.body[0])+1 > len(m.body) {
+		return nil, ErrProtocol
+	}
+	h := md5.New()
+	h.Write([]byte{m.id})
+	h.Write([]byte(o.Password))
+	h.Write(m.body[1 : 1+int(m.body[0])])
+	b := append([]byte{16}, h.Sum(nil)...)
+	b = append(b, o.wireUsername()...)
+	return frame(4, 2, m.id, b), nil
+}
+
+type negotiated struct {
+	tcp, udp []uint16
+	dns      netip.AddrPort
+	interval time.Duration
+	retries  uint16
+}
+
+func parseConfigure(b []byte) (negotiated, error) {
+	n := negotiated{interval: 15 * time.Second, retries: 3}
+	opts, err := parseOptions(b, true)
+	if err != nil {
+		return n, err
+	}
+	a := opts[3]
+	if len(a) != 2 || a[0] != 4 || a[1] != 5 {
+		return n, ErrProtocol
+	}
+	if v, ok := opts[4]; ok {
+		if len(v) != 4 {
+			return n, ErrProtocol
+		}
+		n.tcp = []uint16{binary.BigEndian.Uint16(v)}
+		n.udp = []uint16{binary.BigEndian.Uint16(v[2:])}
+	}
+	for _, item := range []struct {
+		k   byte
+		out *[]uint16
+	}{{19, &n.tcp}, {20, &n.udp}} {
+		if v, ok := opts[item.k]; ok {
+			if len(v) < 1 || len(v) != 1+2*int(v[0]) {
+				return n, ErrProtocol
+			}
+			ports := []uint16{}
+			for i := 0; i < int(v[0]) && i < 4; i++ {
+				p := binary.BigEndian.Uint16(v[1+i*2:])
+				found := false
+				for _, x := range ports {
+					found = found || x == p
+				}
+				if !found {
+					ports = append(ports, p)
+				}
+			}
+			sort.Slice(ports, func(i, j int) bool { return ports[i] < ports[j] })
+			*item.out = ports
+		}
+	}
+	for _, ports := range [][]uint16{n.tcp, n.udp} {
+		if len(ports) == 0 {
+			return n, ErrProtocol
+		}
+		for _, p := range ports {
+			if p == 0 {
+				return n, ErrProtocol
+			}
+		}
+	}
+	if v, ok := opts[6]; ok {
+		if len(v) != 4 {
+			return n, ErrProtocol
+		}
+		s := binary.BigEndian.Uint16(v)
+		n.retries = binary.BigEndian.Uint16(v[2:])
+		if s < 5 || s > 3600 || n.retries == 0 {
+			return n, ErrProtocol
+		}
+		n.interval = time.Duration(s) * time.Second
+	}
+	if v, ok := opts[9]; ok {
+		if len(v) < 1 || int(v[0]) != len(v)-1 {
+			return n, ErrProtocol
+		}
+		ip, e := netip.ParseAddr(string(v[1:]))
+		if e != nil || !ip.Is4() {
+			return n, ErrProtocol
+		}
+		// CN2 may announce an address without a DNS port; its DNS queries
+		// travel as ordinary UDP and do not require this optional endpoint.
+		if p, ok := opts[18]; ok {
+			if len(p) != 2 || binary.BigEndian.Uint16(p) == 0 {
+				return n, ErrProtocol
+			}
+			n.dns = netip.AddrPortFrom(ip, binary.BigEndian.Uint16(p))
+		}
+	}
+	return n, nil
+}
+func parseSuccess(m message) ([16]byte, error) {
+	var token [16]byte
+	b := m.body
+	switch m.code {
+	case 7, 5:
+		if len(b) < 3 || int(b[2]) != len(b)-3 {
+			return token, ErrProtocol
+		}
+		b = b[3:]
+		if m.code == 7 {
+			opts, err := parseOptions(b, false)
+			if err != nil {
+				return token, err
+			}
+			b = opts[2]
+		}
+	case 3:
+	default:
+		return token, ErrProtocol
+	}
+	if len(b) != 16 {
+		return token, ErrProtocol
+	}
+	copy(token[:], b)
+	return token, nil
+}
+func addrOption(ap netip.AddrPort) []byte {
+	b := make([]byte, 16)
+	binary.BigEndian.PutUint16(b, 2)
+	binary.BigEndian.PutUint16(b[2:], ap.Port())
+	ip := ap.Addr().As4()
+	copy(b[4:], ip[:])
+	return b
+}
+func sessionInit(o Options, token [16]byte, mask [8]byte, source, target netip.AddrPort) []byte {
+	b := option(1, token[:], false)
+	if target.IsValid() {
+		b = append(b, option(2, addrOption(target), false)...)
+	}
+	b = append(b, option(7, be16(uint16(o.mtu())), false)...)
+	b = append(b, option(10, []byte(o.dataArea()), false)...)
+	if target.IsValid() {
+		b = append(b, option(2, addrOption(target), false)...)
+	}
+	b = append(b, option(3, addrOption(source), false)...)
+	kind := byte(17)
+	if target.IsValid() {
+		kind = 8
+	}
+	b = append(b, option(kind, mask[:], false)...)
+	out := append(append([]byte{}, dataMagic...), be16(0x8000|uint16(len(b)))...)
+	return append(out, b...)
+}
+func checkACK(b []byte) error {
+	if len(b) != 14 || b[0] != 5 {
+		return ErrProtocol
+	}
+	if b[1] == 3 {
+		return ErrSession
+	}
+	if b[1] != 0 {
+		return ErrProtocol
+	}
+	return nil
+}
+func xor(b []byte, mask [8]byte, offset uint64) {
+	for i := range b {
+		b[i] ^= mask[(offset+uint64(i))&7]
+	}
+}
+func udpFrame(target netip.AddrPort, b []byte, mask [8]byte) []byte {
+	out := make([]byte, 10+len(b))
+	out[1] = 6
+	binary.BigEndian.PutUint16(out[4:], target.Port())
+	ip := target.Addr().As4()
+	copy(out[6:], ip[:])
+	copy(out[10:], b)
+	xor(out[10:], mask, 0)
+	return out
+}
+func parseUDP(b []byte, mask [8]byte) (netip.AddrPort, []byte, error) {
+	if len(b) < 10 || b[0] != 0 || b[1] != 6 {
+		return netip.AddrPort{}, nil, ErrProtocol
+	}
+	var ip [4]byte
+	copy(ip[:], b[6:10])
+	ap := netip.AddrPortFrom(netip.AddrFrom4(ip), binary.BigEndian.Uint16(b[4:]))
+	if ap.Port() == 0 {
+		return ap, nil, ErrProtocol
+	}
+	xor(b[10:], mask, 0)
+	return ap, b[10:], nil
+}
